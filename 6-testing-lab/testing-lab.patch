+def _testing_lab_admin() -> bool:
+    """Testing Lab gate: strictly the session's identity_email — the real
+    human who logged in. session['email'] is deliberately NOT consulted: it
+    gets swapped during admin impersonation and team-workspace switches, so a
+    plain-email gate would leak the Lab into (or out of) swapped sessions.
+    identity_email always stays the actual person."""
+    email = session.get("identity_email") or ""
+    if not email:
+        # Legacy cookies minted before identity_email existed carry only
+        # user_id/email (and _heal_session never runs for them — user_id is
+        # present). Recover the real human from the users row, NOT from the
+        # session email string, and heal the session for next time.
+        uid = session.get("identity_user_id") or session.get("user_id")
+        if uid is None:
+            return False
+        conn = get_db()
+        try:
+            row = conn.execute(
+                "SELECT email FROM users WHERE id = ?", (uid,)
+            ).fetchone()
+        finally:
+            conn.close()
+        email = (row["email"] if row else "") or ""
+        if email:
+            session["identity_email"] = email
+    return _is_admin_email(email)
+
+
+def testing_lab_required(f):
+    """404 for non-admin API calls (the Lab must be invisible, not
+    'forbidden'); redirect home off the page route, like /factory.
+    Unauthenticated requests never get this far — require_auth 401s them."""
+    @wraps(f)
+    def decorated(*args, **kwargs):
+        if not _testing_lab_admin():
+            if request.path.startswith("/api/"):
+                return jsonify({"error": "Not found"}), 404
+            return redirect("/")
+        return f(*args, **kwargs)
+    return decorated
