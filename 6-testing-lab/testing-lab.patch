+@app.route("/api/lab/board", methods=["GET"])
+@testing_lab_required
+def lab_board():
+    """The whole board in one shot: tests newest-first, runs oldest-first
+    (a new run lands as the rightmost column)."""
+    conn = get_db()
+    try:
+        tests = [dict(r) for r in conn.execute(
+            "SELECT * FROM lab_tests ORDER BY id DESC").fetchall()]
+        for t in tests:
+            t["runs"] = [_lab_run_dict(r) for r in conn.execute(
+                "SELECT * FROM lab_runs WHERE test_id = ? ORDER BY id ASC",
+                (t["id"],)).fetchall()]
+    finally:
+        conn.close()
+    return jsonify({"tests": tests})
+
+
+@app.route("/api/lab/tests", methods=["POST"])
+@testing_lab_required
+def lab_create_test():
+    data = request.get_json(force=True, silent=True) or {}
+    prompt = str(data.get("prompt") or "").strip()
+    if not prompt:
+        return jsonify({"error": "prompt is required"}), 400
+    conn = get_db()
+    try:
+        cur = conn.execute("INSERT INTO lab_tests (prompt) VALUES (?)", (prompt,))
+        conn.commit()
+        row = conn.execute("SELECT * FROM lab_tests WHERE id = ?",
+                           (cur.lastrowid,)).fetchone()
+    finally:
+        conn.close()
+    test = dict(row)
+    test["runs"] = []
+    return jsonify({"ok": True, "test": test}), 201
+
+
+@app.route("/api/lab/tests/<int:test_id>", methods=["PATCH"])
+@testing_lab_required
+def lab_update_test(test_id):
+    data = request.get_json(force=True, silent=True) or {}
+    prompt = str(data.get("prompt") or "").strip()
+    if not prompt:
+        return jsonify({"error": "prompt is required"}), 400
+    conn = get_db()
+    try:
+        cur = conn.execute("UPDATE lab_tests SET prompt = ? WHERE id = ?",
+                           (prompt, test_id))
+        conn.commit()
+    finally:
+        conn.close()
+    if cur.rowcount == 0:
+        return jsonify({"error": "Not found"}), 404
+    return jsonify({"ok": True})
+
+
+@app.route("/api/lab/tests/<int:test_id>", methods=["DELETE"])
+@testing_lab_required
+def lab_delete_test(test_id):
+    conn = get_db()
+    try:
+        run_ids = [r["id"] for r in conn.execute(
+            "SELECT id FROM lab_runs WHERE test_id = ?", (test_id,)).fetchall()]
+        cur = conn.execute("DELETE FROM lab_tests WHERE id = ?", (test_id,))
+        conn.execute("DELETE FROM lab_runs WHERE test_id = ?", (test_id,))
+        conn.commit()
+    finally:
+        conn.close()
+    if cur.rowcount == 0:
+        return jsonify({"error": "Not found"}), 404
+    for rid in run_ids:
+        _lab_remove_shot_dir(rid)
+    return jsonify({"ok": True})
+
+
+@app.route("/api/lab/tests/<int:test_id>/runs", methods=["POST"])
+@testing_lab_required
+def lab_create_run(test_id):
+    """One-click 'add a run': every field is optional, the column appears
+    immediately and gets filled in inline on the board."""
+    data = request.get_json(force=True, silent=True) or {}
+    fields, err = _lab_run_fields(data, partial=False)
+    if err:
+        return jsonify({"error": err}), 400
+    conn = get_db()
+    try:
+        if not conn.execute("SELECT 1 FROM lab_tests WHERE id = ?",
+                            (test_id,)).fetchone():
+            return jsonify({"error": "Not found"}), 404
+        cur = conn.execute(
+            "INSERT INTO lab_runs (test_id, model_name, verdict, notes, run_date) "
+            "VALUES (?, ?, ?, ?, COALESCE(NULLIF(?, ''), date('now')))",
+            (test_id, fields["model_name"], fields["verdict"],
+             fields.get("notes", ""), fields.get("run_date", "")),
+        )
+        conn.commit()
+        row = conn.execute("SELECT * FROM lab_runs WHERE id = ?",
+                           (cur.lastrowid,)).fetchone()
+    finally:
+        conn.close()
+    return jsonify({"ok": True, "run": _lab_run_dict(row)}), 201
+
+
+@app.route("/api/lab/runs/<int:run_id>", methods=["PATCH"])
+@testing_lab_required
+def lab_update_run(run_id):
+    data = request.get_json(force=True, silent=True) or {}
+    fields, err = _lab_run_fields(data, partial=True)
+    if err:
+        return jsonify({"error": err}), 400
+    conn = get_db()
+    try:
+        if not fields:
+            row = conn.execute("SELECT * FROM lab_runs WHERE id = ?",
+                               (run_id,)).fetchone()
+            if not row:
+                return jsonify({"error": "Not found"}), 404
+            return jsonify({"ok": True, "run": _lab_run_dict(row)})
+        sets = ", ".join(f"{k} = ?" for k in fields)
+        cur = conn.execute(f"UPDATE lab_runs SET {sets} WHERE id = ?",
+                           (*fields.values(), run_id))
+        conn.commit()
+        if cur.rowcount == 0:
+            return jsonify({"error": "Not found"}), 404
+        row = conn.execute("SELECT * FROM lab_runs WHERE id = ?",
+                           (run_id,)).fetchone()
+    finally:
+        conn.close()
+    return jsonify({"ok": True, "run": _lab_run_dict(row)})
+
+
+@app.route("/api/lab/runs/<int:run_id>", methods=["DELETE"])
+@testing_lab_required
+def lab_delete_run(run_id):
+    conn = get_db()
+    try:
+        cur = conn.execute("DELETE FROM lab_runs WHERE id = ?", (run_id,))
+        conn.commit()
+    finally:
+        conn.close()
+    if cur.rowcount == 0:
+        return jsonify({"error": "Not found"}), 404
+    _lab_remove_shot_dir(run_id)
+    return jsonify({"ok": True})
+
+
+@app.route("/api/lab/runs/<int:run_id>/screenshots", methods=["POST"])
+@testing_lab_required
+def lab_add_screenshots(run_id):
+    files = [f for f in request.files.getlist("file") if f and f.filename]
+    if not files:
+        return jsonify({"error": "No file provided"}), 400
+    for f in files:
+        if Path(f.filename).suffix.lower() not in _LAB_SHOT_EXTS:
+            return jsonify({"error": "Only png/jpg/jpeg/webp/gif allowed"}), 400
+    conn = get_db()
+    try:
+        row = conn.execute("SELECT * FROM lab_runs WHERE id = ?",
+                           (run_id,)).fetchone()
+        if not row:
+            return jsonify({"error": "Not found"}), 404
+        shots = _lab_run_dict(row)["screenshots"]
+        dest = _lab_shot_dir(run_id)
+        dest.mkdir(parents=True, exist_ok=True)
+        for f in files:
+            name = f"{uuid.uuid4().hex}{Path(f.filename).suffix.lower()}"
+            f.save(str(dest / name))
+            # URL is built as a constant prefix (not derived from UPLOAD_DIR)
+            # so tests can point UPLOAD_DIR at a temp dir.
+            shots.append(f"/static/uploads/lab/{run_id}/{name}")
+        conn.execute("UPDATE lab_runs SET screenshots = ? WHERE id = ?",
+                     (json.dumps(shots), run_id))
+        conn.commit()
+    finally:
+        conn.close()
+    return jsonify({"ok": True, "screenshots": shots})
+
+
+@app.route("/api/lab/runs/<int:run_id>/screenshots", methods=["DELETE"])
+@testing_lab_required
+def lab_delete_screenshot(run_id):
+    data = request.get_json(force=True, silent=True) or {}
+    url = str(data.get("url") or "")
+    conn = get_db()
+    try:
+        row = conn.execute("SELECT * FROM lab_runs WHERE id = ?",
+                           (run_id,)).fetchone()
+        if not row:
+            return jsonify({"error": "Not found"}), 404
+        shots = _lab_run_dict(row)["screenshots"]
+        if url not in shots:
+            return jsonify({"error": "Not found"}), 404
+        shots.remove(url)
+        conn.execute("UPDATE lab_runs SET screenshots = ? WHERE id = ?",
+                     (json.dumps(shots), run_id))
+        conn.commit()
+    finally:
+        conn.close()
+    # Unlink by basename only — the URL never becomes a filesystem path, so a
+    # crafted url can't traverse outside this run's folder.
+    target = _lab_shot_dir(run_id) / Path(url).name
+    try:
+        target.unlink(missing_ok=True)
+    except OSError:
+        app.logger.warning("lab: could not unlink %s", target)
+    return jsonify({"ok": True, "screenshots": shots})
+
