+# ── Testing Lab: admin-only AI model comparison board ─────────────────────
+# One lab_tests row per experiment (anchored by the exact prompt); each
+# lab_runs row is one model attempt — a column on the board. Every route is
+# behind testing_lab_required (identity_email gate, 404 to everyone else),
+# so the Lab simply does not exist for non-admins.
+
+LAB_VERDICTS = ("pending", "win", "good", "mixed", "fail")
+_LAB_SHOT_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".gif")
+
+
+def _lab_run_dict(row):
+    d = dict(row)
+    try:
+        d["screenshots"] = json.loads(d.get("screenshots") or "[]")
+    except (json.JSONDecodeError, TypeError):
+        d["screenshots"] = []
+    return d
 
 
+def _lab_shot_dir(run_id: int) -> Path:
+    return UPLOAD_DIR / "lab" / str(run_id)
+
+
+def _lab_remove_shot_dir(run_id: int):
+    """Best-effort cleanup of a run's screenshot folder on run/test delete."""
+    d = _lab_shot_dir(run_id)
+    try:
+        if d.is_dir():
+            for f in d.iterdir():
+                f.unlink()
+            d.rmdir()
+    except OSError:
+        app.logger.warning("lab: could not fully remove %s", d)
+
+
+def _lab_run_fields(data, *, partial):
+    """Validate/normalize a run payload. Returns (fields_dict, error)."""
+    out = {}
+    if "model_name" in data or not partial:
+        out["model_name"] = str(data.get("model_name") or "").strip()[:120]
+    if "verdict" in data or not partial:
+        verdict = str(data.get("verdict") or "pending").strip().lower()
+        if verdict not in LAB_VERDICTS:
+            return None, f"verdict must be one of {', '.join(LAB_VERDICTS)}"
+        out["verdict"] = verdict
+    if "notes" in data:
+        out["notes"] = str(data.get("notes") or "").strip()[:4000]
+    if "run_date" in data:
+        out["run_date"] = str(data.get("run_date") or "").strip()[:32]
+    return out, None
+
