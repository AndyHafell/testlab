diff --git a/tests/test_skool_membership.py b/tests/test_skool_membership.py
new file mode 100644
index 0000000..3c6c419
--- /dev/null
+++ b/tests/test_skool_membership.py
@@ -0,0 +1,86 @@
+def test_paid_webhook_sets_tier_paid(app_module, db, client, monkeypatch):
+    monkeypatch.setenv("PAID_WEBHOOK_TOKEN", "pytest-paid-token")
+    r = client.post("/api/admin/paid-members",
+                    headers={"Authorization": "Bearer pytest-paid-token"},
+                    json={"email": "payer@x.com", "name": "Payer"})
+    assert r.status_code == 200
+    row = db.execute("SELECT tier, allowlist_source FROM users WHERE email='payer@x.com'").fetchone()
+    assert row["tier"] == "paid"
+    assert row["allowlist_source"] == "paid"
+
+
+def _sync(client, emails=None, **extra):
+    body = {"members": [{"email": e} for e in (emails or [])]}
+    body.update(extra)   # e.g. reconcile=True, revoke=[...]
+    return client.post("/api/admin/skool-members",
+                       headers={"Authorization": "Bearer pytest-paid-token"}, json=body)
+
+
+def _seed_skool(db, seed_user, email, handle):
+    uid = seed_user(email, handle)
+    db.execute("UPDATE users SET allowlist_source='skool' WHERE id=?", (uid,)); db.commit()
+    return uid
+
+
+def test_sync_reconcile_allowlists_roster_and_revokes_absent(app_module, db, client, monkeypatch, seed_user):
+    monkeypatch.setenv("PAID_WEBHOOK_TOKEN", "pytest-paid-token")
+    _seed_skool(db, seed_user, "keep@x.com", "keep")
+    _seed_skool(db, seed_user, "gone@x.com", "gone")
+    # FULL-ROSTER reconcile: gone@ absent -> revoked; new@ added; keep@ stays.
+    r = _sync(client, ["keep@x.com", "new@x.com"], reconcile=True)
+    assert r.status_code == 200
+    assert db.execute("SELECT allowlisted FROM users WHERE email='keep@x.com'").fetchone()["allowlisted"] == 1
+    assert db.execute("SELECT allowlisted FROM users WHERE email='new@x.com'").fetchone()["allowlisted"] == 1
+    assert db.execute("SELECT allowlisted FROM users WHERE email='gone@x.com'").fetchone()["allowlisted"] == 0
+
+
+def test_sync_additive_default_does_not_revoke_absent(app_module, db, client, monkeypatch, seed_user):
+    """A partial payload (the per-record Zapier flow) must NOT wipe other members."""
+    monkeypatch.setenv("PAID_WEBHOOK_TOKEN", "pytest-paid-token")
+    _seed_skool(db, seed_user, "existing@x.com", "exist")
+    r = _sync(client, ["new-joiner@x.com"])   # no reconcile flag
+    assert r.status_code == 200
+    # existing member is untouched (NOT revoked), new joiner is added.
+    assert db.execute("SELECT allowlisted FROM users WHERE email='existing@x.com'").fetchone()["allowlisted"] == 1
+    assert db.execute("SELECT allowlisted FROM users WHERE email='new-joiner@x.com'").fetchone()["allowlisted"] == 1
+
+
+def test_sync_explicit_revoke_only_hits_skool_paid(app_module, db, client, monkeypatch, seed_user):
+    monkeypatch.setenv("PAID_WEBHOOK_TOKEN", "pytest-paid-token")
+    _seed_skool(db, seed_user, "cancelled@x.com", "canc")
+    m = seed_user("founder@x.com", "found")
+    db.execute("UPDATE users SET allowlist_source='manual' WHERE id=?", (m,)); db.commit()
+    r = _sync(client, revoke=["cancelled@x.com", "founder@x.com"])
+    assert r.status_code == 200
+    assert db.execute("SELECT allowlisted FROM users WHERE email='cancelled@x.com'").fetchone()["allowlisted"] == 0
+    # the manual override is protected even when explicitly listed in revoke.
+    assert db.execute("SELECT allowlisted FROM users WHERE email='founder@x.com'").fetchone()["allowlisted"] == 1
+
+
+def test_sync_never_revokes_manual_or_seed(app_module, db, client, monkeypatch, seed_user):
+    monkeypatch.setenv("PAID_WEBHOOK_TOKEN", "pytest-paid-token")
+    m = seed_user("manual@x.com", "man")
+    db.execute("UPDATE users SET allowlist_source='manual' WHERE id=?", (m,)); db.commit()
+    # even a FULL reconcile that omits manual@ must not revoke it.
+    _sync(client, ["someone-else@x.com"], reconcile=True)
+    assert db.execute("SELECT allowlisted FROM users WHERE email='manual@x.com'").fetchone()["allowlisted"] == 1
+
+
+def test_sync_requires_token(app_module, client):
+    r = client.post("/api/admin/skool-members", json={"members": []})
+    assert r.status_code == 401
+
+
+def test_non_member_email_is_refused_no_trial(app_module, db, client, monkeypatch):
+    monkeypatch.setenv("ADMIN_LOGIN_PASSWORD", "admin")
+    r = client.post("/api/auth/skool/activate", json={"email": "stranger@x.com", "code": "admin"})
+    assert r.status_code in (401, 403)
+    row = db.execute("SELECT allowlisted FROM users WHERE email='stranger@x.com'").fetchone()
+    assert row is None or row["allowlisted"] == 0   # NO trial row granted
+
+
+def test_member_email_gets_in_at_free(app_module, db, client, seed_user, monkeypatch):
+    monkeypatch.setenv("ADMIN_LOGIN_PASSWORD", "admin")
+    seed_user("member@x.com", "mem")   # allowlisted=1 via conftest
+    r = client.post("/api/auth/skool/activate", json={"email": "member@x.com", "code": "admin"})
+    assert r.status_code == 200
