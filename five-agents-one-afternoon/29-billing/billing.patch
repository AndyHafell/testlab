+def _owner_required(kwarg: str, owns):
+    """Build an ownership-gate decorator that 404s when the current user doesn't
+    own the row named by path-param `kwarg`. `owns(row_id) -> bool` runs the
+    actual check (a user_id-scoped table lookup, or a join-via-video lookup for
+    child tables). The `is not None` guard mirrors the original per-resource
+    decorators: a missing path param falls through to the handler unchecked."""
+    def wrapper(f):
+        @wraps(f)
+        def decorated(*args, **kwargs):
+            row_id = kwargs.get(kwarg)
+            if row_id is not None and not owns(row_id):
+                return jsonify({"error": "not found"}), 404
+            return f(*args, **kwargs)
+        return decorated
+    return wrapper
+
+
+# 404 when the current user doesn't own the path-param resource. Videos,
+# channels and show_docs carry their own user_id (_owns_scoped); diagrams
+# cascade ownership from their parent video (_owns_via_video).
+video_owner_required = _owner_required("vid", lambda i: _owns_scoped("videos", "id", i))
+diagram_owner_required = _owner_required("diagram_id", lambda i: _owns_via_video("diagrams", "id", i))
+channel_owner_required = _owner_required("cid", lambda i: _owns_scoped("channels", "id", i))
+show_doc_owner_required = _owner_required("sid", lambda i: _owns_scoped("show_docs", "id", i))
 
 
