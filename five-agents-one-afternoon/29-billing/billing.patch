+@app.route("/api/admin/skool-members", methods=["POST"])
+def admin_skool_members():
+    """Airtable-driven membership reconcile. Token-authed (shared secret, same
+    as the paid webhook).
+
+    Body:
+      {"members":[{"email":...,"paid":bool?}...]}  — allowlist these (UPSERT).
+      {"revoke":["email",...]}                     — revoke these (skool/paid only).
+      {"reconcile": true}                          — opt-in FULL-ROSTER mode: also
+          revoke any skool/paid user ABSENT from `members`.
+
+    ADDITIVE BY DEFAULT: without `reconcile`, only the listed members/revokes are
+    touched — a single-record webhook (the per-answer Zapier→Airtable flow) can
+    NEVER wipe other members. Use `reconcile: true` only when sending the full
+    current roster. Revocation never touches seed/manual/legacy rows."""
+    sent = (request.headers.get("Authorization") or "").removeprefix("Bearer ").strip()
+    token = os.environ.get("PAID_WEBHOOK_TOKEN", "")
+    if not token or sent != token:
+        return jsonify({"error": "Unauthorized"}), 401
+    data = _json_body()
+    members = data.get("members") or []
+    roster = {(m.get("email") or "").strip().lower() for m in members if m.get("email")}
+    paid_set = {(m.get("email") or "").strip().lower() for m in members if m.get("email") and m.get("paid")}
+    revoke = {(e or "").strip().lower() for e in (data.get("revoke") or []) if e}
+    reconcile = bool(data.get("reconcile"))
+    conn = get_db()
+    try:
+        for email in roster:
+            paid = email in paid_set
+            src = "paid" if paid else "skool"
+            tier = "paid" if paid else "free"
+            conn.execute(
+                "INSERT INTO users (email, allowlisted, allowlist_source, allowlisted_at, tier) "
+                "VALUES (?, 1, ?, datetime('now'), ?) "
+                "ON CONFLICT(email) DO UPDATE SET allowlisted=1, "
+                "  allowlist_source=?, revoked_at=NULL, "
+                "  allowlisted_at=COALESCE(users.allowlisted_at, datetime('now')), "
