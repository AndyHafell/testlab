diff --git a/tests/test_budget_enforcement.py b/tests/test_budget_enforcement.py
new file mode 100644
index 0000000..773ce84
--- /dev/null
+++ b/tests/test_budget_enforcement.py
@@ -0,0 +1,197 @@
+import io
+import usage_budget as ub
+
+
+def _seed_tier(db, uid, tier, used=0):
+    db.execute("UPDATE users SET tier=?, usage_cents=?, usage_period=strftime('%Y-%m','now') "
+               "WHERE id=?", (tier, used, uid))
+    db.commit()
+
+
+def _max_out(db, uid):
+    db.execute("UPDATE users SET tier='free', usage_cents=?, usage_period=? WHERE id=?",
+               (ub.TIER_CAP['free'], ub.current_period(), uid))
+    db.commit()
+
+
+def _seed_owned_video(db, uid, title="Test Video"):
+    cur = db.execute(
+        "INSERT INTO videos (video_id, title, user_id) VALUES (?, ?, ?)",
+        (f"vid_{uid}_{title[:4]}", title, uid),
+    )
+    db.commit()
+    return cur.lastrowid
+
+
+def _seed_owned_diagram(db, vid, image_path="static/uploads/diagrams/1/test.png"):
+    import uuid
+    did = "d" + uuid.uuid4().hex[:14]
+    db.execute(
+        "INSERT INTO diagrams (id, video_id, name, boxes_json, image_path, position) "
+        "VALUES (?, ?, ?, '[]', ?, 0)",
+        (did, vid, "Step 1: Test", image_path),
+    )
+    db.commit()
+    return did
+
+
+# ── Core unit tests ───────────────────────────────────────────────────────────
+
+def test_require_budget_allows_under_cap(app_module, db, seed_user):
+    uid = seed_user("free1@x.com", "free1")
+    _seed_tier(db, uid, "free", used=0)
+    with app_module.app.test_request_context():
+        conn = app_module.get_db()
+        assert app_module.require_budget(conn, uid, "image_pro", 1) is None  # 20c <= 100c
+        conn.close()
+
+
+def test_require_budget_blocks_over_cap_with_402(app_module, db, seed_user):
+    uid = seed_user("free2@x.com", "free2")
+    _seed_tier(db, uid, "free", used=95)            # 95c used, cap 100c
+    with app_module.app.test_request_context():
+        conn = app_module.get_db()
+        guard = app_module.require_budget(conn, uid, "image_pro", 1)  # +20c -> over
+        conn.close()
+    assert guard is not None
+    resp, status = guard
+    assert status == 402
+    body = resp.get_json()
+    assert body["error"] == "budget_exhausted"
+    assert body["remaining_cents"] == 5
+    assert body["cap_cents"] == 100
+
+
+def test_admin_is_never_blocked(app_module, db, seed_user, monkeypatch):
+    uid = seed_user("admin@x.com", "adm")
+    _seed_tier(db, uid, "free", used=999)
+    monkeypatch.setattr(app_module, "_is_admin_email", lambda e: True)
+    with app_module.app.test_request_context():
+        conn = app_module.get_db()
+        assert app_module.require_budget(conn, uid, "image_pro", 1) is None
+        conn.close()
+
+
+def test_ai_keys_are_server_only(app_module, db, seed_user, monkeypatch):
+    uid = seed_user("byo@x.com", "byo")
+    db.execute("UPDATE users SET gemini_api_key='USERKEY', youtube_api_key='USERYT' WHERE id=?", (uid,))
+    db.commit()
+    monkeypatch.setenv("GEMINI_API_KEY", "SERVERKEY")
+    monkeypatch.setenv("YOUTUBE_API_KEY", "SERVERYT")
+    assert app_module._user_gemini_key(uid) == "SERVERKEY"
+    assert app_module._user_youtube_key(uid) == "SERVERYT"
+
+
+# ── 402 block tests — one per paid-AI endpoint ───────────────────────────────
+
+# NOTE: factory_faceless, gemini_faceless, gemini_pixel_face are admin-only
+# routes (require _is_admin_email to pass the gate before any budget check).
+# Admins are budget-exempt in require_budget, so the 402 path is structurally
+# unreachable for these routes. Budget metering (record_spend) is still wired
+# in for spend-tracking purposes when admins do use them.
