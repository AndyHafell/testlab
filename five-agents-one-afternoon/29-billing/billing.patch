--- /dev/null
+++ b/tests/test_migration.py
@@ -0,0 +1,19 @@
+"""Tests for the fresh-DB migration path (_maybe_drop_videos_video_id_unique).
+
+A fresh DB built by init_db() + migrate_schema() must end up with a videos
+table that has no column-level UNIQUE on video_id, and still carries all
+late-added columns (scheduled_at, writing_doc).
+"""
+
+
+def test_fresh_db_migrates_without_crashing(app_module, db):
+    """A fresh DB (built by init_db+migrate at import) must end up with a
+    `videos` table that has NO column-level UNIQUE on video_id, and still
+    carries the late-added columns (scheduled_at, writing_doc)."""
+    sql = db.execute(
+        "SELECT sql FROM sqlite_master WHERE type='table' AND name='videos'"
+    ).fetchone()["sql"]
+    assert "video_id TEXT UNIQUE" not in sql
+    cols = {r["name"] for r in db.execute("PRAGMA table_info(videos)")}
+    assert "scheduled_at" in cols
+    assert "writing_doc" in cols
