+# ── Website visitors (Cloudflare → persisted local history) ────────────────
+def _site_visits_table(conn):
+    conn.execute(
+        "CREATE TABLE IF NOT EXISTS site_visits ("
+        "domain TEXT NOT NULL, day TEXT NOT NULL, uniques INTEGER, "
+        "pageviews INTEGER, PRIMARY KEY(domain, day))"
+    )
+
+
+def _cf_sites():
+    """CF_SITES env = JSON {domain: {type:'zone'|'rum', tag, account}}."""
+    try:
+        return json.loads(os.environ.get("CF_SITES", "") or "{}")
+    except ValueError:
+        return {}
+
+
+def _cf_query(cfg, start, end, hdr):
+    """Daily uniques for one Cloudflare site → [(day, uniques, pageviews)].
+    Zone analytics for proxied domains; RUM (Web Analytics) for Pages sites."""
+    from urllib.request import urlopen, Request
+    if cfg.get("type") == "rum":
+        q = ("query($acc:String!,$start:Date!,$end:Date!,$site:String!){viewer{accounts(filter:{accountTag:$acc}){"
+             "rumPageloadEventsAdaptiveGroups(limit:1000,filter:{date_geq:$start,date_leq:$end,siteTag:$site}){"
+             "dimensions{date} sum{visits} count}}}}")
+        variables = {"acc": cfg.get("account"), "start": start.isoformat(),
+                     "end": end.isoformat(), "site": cfg.get("tag")}
+    else:
+        q = ("query($tag:String!,$start:String!,$end:String!){viewer{zones(filter:{zoneTag:$tag}){"
+             "httpRequests1dGroups(limit:90,filter:{date_geq:$start,date_leq:$end}){"
+             "dimensions{date} uniq{uniques} sum{pageViews}}}}}")
+        variables = {"tag": cfg.get("tag"), "start": start.isoformat(), "end": end.isoformat()}
+    body = json.dumps({"query": q, "variables": variables}).encode()
+    resp = json.loads(urlopen(
+        Request("https://api.cloudflare.com/client/v4/graphql", data=body, headers=hdr), timeout=25).read())
+    out = []
+    try:
+        if cfg.get("type") == "rum":
+            for g in resp["data"]["viewer"]["accounts"][0]["rumPageloadEventsAdaptiveGroups"]:
+                out.append((g["dimensions"]["date"], g["sum"].get("visits", 0), g.get("count", 0)))
+        else:
+            for g in resp["data"]["viewer"]["zones"][0]["httpRequests1dGroups"]:
+                out.append((g["dimensions"]["date"], g["uniq"]["uniques"], g["sum"]["pageViews"]))
+    except Exception as e:
+        print(f"[dash] CF parse failed: {e}", flush=True)
+    return out
+
+
+def _cf_visitor_sync():
+    """Pull last ~30d daily uniques per configured CF site and upsert into
+    site_visits (accumulates history past CF's ~30-day retention). Best-effort;
+    needs CF_API_TOKEN + CF_SITES. Returns True if any site synced."""
+    token = os.environ.get("CF_API_TOKEN", "")
+    sites = _cf_sites()
+    if not token or not sites:
+        return False
+    from datetime import date, timedelta
+    end = date.today()
+    start = end - timedelta(days=30)
+    hdr = {"Authorization": f"Bearer {token}", "Content-Type": "application/json",
+           "User-Agent": "cg-dashboard"}
+    synced = False
+    conn = get_db()
+    try:
+        _site_visits_table(conn)
+        for domain, cfg in sites.items():
+            try:
+                for day, uniq, pv in _cf_query(cfg, start, end, hdr):
+                    conn.execute(
+                        "INSERT INTO site_visits (domain, day, uniques, pageviews) VALUES (?,?,?,?) "
+                        "ON CONFLICT(domain, day) DO UPDATE SET uniques=excluded.uniques, "
+                        "pageviews=excluded.pageviews",
+                        (domain, day, uniq, pv))
+                    synced = True
+            except Exception as e:
+                print(f"[dash] CF sync {domain} failed: {e}", flush=True)
+        conn.commit()
+    finally:
+        conn.close()
+    return synced
+
