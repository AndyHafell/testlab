+  else{const pts=series.map((d,i)=>[x(i),y(d.value)]);const line=smoothPath(pts);const area=`${line}L${x(series.length-1)},${y(0)}L${x(0)},${y(0)}Z`;inner+=`<path class="chart-area" d="${area}" fill="url(#ag-${opts.id})"/><path id="ln-${opts.id}" d="${line}" fill="none" stroke="${color}" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" style="filter:drop-shadow(0 0 6px ${color}88)"/>`;}
