+def _site_visitors():
+    """Per-site 30/90-day + all-time uniques AND a daily series (for the website
+    -visitors overview chart), from site_visits. CreatorGrowth falls back to the
+    built-in visitor_pings counter with a daily new-visitor series."""
+    from datetime import timedelta
+    sites = {}
+    conn = get_db()
+    try:
+        _site_visits_table(conn)
+        today = datetime.now(timezone.utc).date()
+        d30, d90 = (today - timedelta(days=30)).isoformat(), (today - timedelta(days=90)).isoformat()
+        agg, series = {}, {}
+        for r in conn.execute("SELECT domain, day, uniques FROM site_visits ORDER BY day").fetchall():
+            a = agg.setdefault(r["domain"], {"d30": 0, "d90": 0, "all": 0})
+            u = r["uniques"] or 0
+            a["all"] += u
+            if r["day"] >= d90:
+                a["d90"] += u
+            if r["day"] >= d30:
+                a["d30"] += u
+            series.setdefault(r["domain"], []).append({"day": r["day"], "uniques": u})
+        for dom, a in agg.items():
+            sites[dom] = {"d30": a["d30"], "d90": a["d90"], "all_time": a["all"],
+                          "source": "cloudflare", "series": series.get(dom, [])}
+        if "creatorgrowth.com" not in sites:
+            try:
+                now = int(time.time())
+                allc = conn.execute("SELECT COUNT(*) FROM visitor_pings").fetchone()[0]
+                c30 = conn.execute("SELECT COUNT(*) FROM visitor_pings WHERE last_seen>=?", (now - 30 * 86400,)).fetchone()[0]
+                c90 = conn.execute("SELECT COUNT(*) FROM visitor_pings WHERE last_seen>=?", (now - 90 * 86400,)).fetchone()[0]
+                cg_series = [{"day": row["d"], "uniques": row["c"]}
+                             for row in conn.execute(
+                                 "SELECT date(first_seen,'unixepoch') d, COUNT(*) c FROM visitor_pings "
+                                 "GROUP BY d ORDER BY d").fetchall() if row["d"]]
+                sites["creatorgrowth.com"] = {"d30": c30, "d90": c90, "all_time": allc,
+                                              "source": "visitor_pings", "series": cg_series}
+            except Exception:
+                pass
+    finally:
+        conn.close()
+    return sites
+
+
+def _dashboard_payload(uid):
+    conn = get_db()
+    try:
+        videos, median_views = _dash_videos(conn, uid)
+        archive = _dash_archive(conn, uid)
+        pipe_rows = conn.execute(
+            "SELECT status, COUNT(*) AS n FROM videos WHERE user_id = ? GROUP BY status",
+            (uid,),
+        ).fetchall()
+        pipeline = {r["status"]: r["n"] for r in pipe_rows}
+        this_month = datetime.now(timezone.utc).strftime("%Y-%m")
+        shipped_this_month = conn.execute(
+            "SELECT COUNT(*) AS n FROM videos WHERE user_id = ? AND status = 'published' "
+            "AND substr(published_at, 1, 7) = ?",
+            (uid, this_month),
+        ).fetchone()["n"]
+    finally:
+        conn.close()
+
+    total_views = sum(v["views"] for v in videos)
+    total_likes = sum(v["likes"] for v in videos)
+    total_comments = sum(v["comments"] for v in videos)
+    n_videos = len(videos)
+    uploads_this_month = sum(1 for v in videos if v["published"][:7] == this_month)
+    kpi = _load_kpi_data()
+    months = (kpi or {}).get("months") or []
+
+    def _recent_metric(key):
+        for m in reversed(months):  # newest-first
+            v = m.get(key)
+            if v is not None:
+                return v
+        return None
+
+    ig_views = _recent_metric("ig_views")
+    fb_views = _recent_metric("fb_views")
+    members = _dash_cached("members", 1800, _airtable_members)
+    github = _dash_cached("github", 1800, _github_stars)
+    monthly_real = _dash_cached("yt_monthly", 1800, _yt_monthly_views)
+    windows = _dash_cached("yt_windows", 1800, _yt_windows)
+    _dash_cached("cf_sync", 1800, _cf_visitor_sync)  # keep CF visitor history fresh (<=30min)
+    site_visitors = _site_visitors()
+    return {
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "synced_at": (kpi or {}).get("pulled_at"),
+        "channel": {
+            "subscribers": (kpi or {}).get("current_subs"),
+            "total_views": total_views,
+            "videos": n_videos,
+            "avg_views": round(total_views / n_videos) if n_videos else 0,
+            "total_likes": total_likes,
+            "total_comments": total_comments,
+            "median_views": median_views,
+        },
+        "monthly": _dash_monthly(videos),
+        "videos": videos,
+        "archive": archive,
+        "pipeline": pipeline,
+        "shipped_this_month": shipped_this_month,
+        "uploads_this_month": uploads_this_month,
+        "this_month": this_month,
+        "check_window_days": DASH_CHECK_WINDOW_DAYS,
+        "platforms": {
+            "youtube": {"connected": True, "views": total_views},
+            "instagram": {"connected": ig_views is not None, "views": ig_views},
+            "facebook": {"connected": fb_views is not None, "views": fb_views},
+        },
+        "refreshable": bool(os.environ.get("META_ACCESS_TOKEN") or os.environ.get("YOUTUBE_API_KEY")),
+        "members": members,
+        "github": github,
+        "monthly_real": (monthly_real or None),
+        "windows": windows,
+        "site_visitors": site_visitors,
+        "kpi": kpi,
+    }
+
+
+@app.route("/api/dashboard", methods=["GET"])
+def creator_dashboard_data():
+    """Aggregate every key stat for the signed-in admin's workspace."""
+    _, err = _require_admin()
+    if err:
+        return err
+    return jsonify(_dashboard_payload(current_user_id()))
+
+
+@app.route("/api/dashboard/check", methods=["POST"])
+def creator_dashboard_check():
+    """Results checker: read a video's real counts, score it against the channel
+    median, archive the result."""
+    _, err = _require_admin()
+    if err:
+        return err
+    uid = current_user_id()
+    vid = (request.get_json(silent=True) or {}).get("video_id")
+    if not vid:
+        return jsonify({"error": "video_id required"}), 400
+    conn = get_db()
+    try:
+        videos, median = _dash_videos(conn, uid)
+        v = next((x for x in videos if x["id"] == vid), None)
+        if v is None:
+            return jsonify({"error": "video not found"}), 404
+        rec = {
+            "id": v["id"], "title": v["title"], "published": v["published"],
+            "views": v["views"], "likes": v["likes"], "comments": v["comments"],
+            "median_at_check": median,
+            "outlier": round(v["views"] / median, 2) if median else 0,
+            "checked_at": int(time.time()), "status": "done",
+        }
+        _dash_archive(conn, uid)  # ensure table exists
+        conn.execute(
+            "INSERT INTO dash_check_archive (user_id, video_id, payload, checked_at) "
+            "VALUES (?, ?, ?, ?) ON CONFLICT(user_id, video_id) DO UPDATE SET "
+            "payload = excluded.payload, checked_at = excluded.checked_at",
+            (uid, vid, json.dumps(rec), rec["checked_at"]),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+    return jsonify(rec)
+
+
+@app.route("/api/dashboard/refresh", methods=["POST"])
+def creator_dashboard_refresh():
+    """Live refresh: pull YouTube channel stats + Instagram/Facebook current-month
+    views into kpi_data.json, and kick a background YouTube video re-sync so new
+    uploads appear. Admin only."""
+    _, err = _require_admin()
+    if err:
+        return err
+    result = {"youtube": False, "instagram": False, "facebook": False, "video_sync": False}
+
+    subs, total_views = _yt_channel_stats()
+    ig, fb = _meta_pull_ig_fb()
+
+    # Merge into kpi_data.json (preserve everything else; update current month).
+    try:
+        with open(KPI_DATA_PATH, "r") as f:
+            kpi_raw = json.load(f)
+    except (OSError, ValueError):
+        kpi_raw = {"months": []}
+    cm = datetime.now(timezone.utc).strftime("%Y-%m")
+    months = kpi_raw.setdefault("months", [])
+    row = next((m for m in months if (m.get("sort_key") or "") == cm), None)
+    if row is None:
+        row = {"month": cm, "sort_key": cm}
+        months.insert(0, row)
+    if ig is not None:
+        row["ig_views"] = ig
+        result["instagram"] = True
+    if fb is not None:
+        row["fb_views"] = fb
+        result["facebook"] = True
+    if subs is not None:
+        kpi_raw["current_subs"] = subs
+        kpi_raw["current_total_views"] = total_views
+        result["youtube"] = True
+    kpi_raw["pulled_at"] = datetime.now(timezone.utc).isoformat()
+    try:
+        with open(KPI_DATA_PATH, "w") as f:
+            json.dump(kpi_raw, f, indent=2)
+    except OSError as e:
+        print(f"[dash-refresh] could not write kpi_data.json: {e}", flush=True)
+
+    # Best-effort background YouTube video re-sync (new uploads → my_channel_videos).
+    if os.environ.get("YOUTUBE_API_KEY"):
+        try:
+            script = str(Path(__file__).resolve().parent / "sync_my_channel.py")
+            if os.path.exists(script):
+                subprocess.Popen(
+                    [sys.executable, script],
+                    cwd=str(Path(__file__).resolve().parent),
+                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                    env={**os.environ, "VIDEOS_DB_PATH": str(DB_PATH)},
+                )
+                result["video_sync"] = True
+        except Exception as e:
+            print(f"[dash-refresh] video sync spawn failed: {e}", flush=True)
+
+    # Force-refresh the cached external sources (bypass the per-worker cache) and
+    # persist a fresh slice of Cloudflare visitor history.
+    _dash_cached("members", 1800, _airtable_members, force=True)
+    _dash_cached("github", 1800, _github_stars, force=True)
+    _dash_cached("yt_monthly", 1800, _yt_monthly_views, force=True)
+    _dash_cached("yt_windows", 1800, _yt_windows, force=True)
+    result["cloudflare"] = _cf_visitor_sync()
+    result["youtube_analytics"] = bool(_DASH_CACHE.get("yt_monthly", (0, None))[1])
+    result["github"] = bool(_DASH_CACHE.get("github", (0, None))[1])
+    result["airtable"] = bool(_DASH_CACHE.get("members", (0, None))[1])
+
+    result["data"] = _dashboard_payload(current_user_id())
+    return jsonify(result)
+
+
 if __name__ == "__main__":
     import webbrowser, threading
     threading.Timer(1.0, lambda: webbrowser.open("http://127.0.0.1:5050")).start()
