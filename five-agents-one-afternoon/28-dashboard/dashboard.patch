+def _load_kpi_data():
+    """Read the AgentMate KPI snapshot live from KPI_DATA_PATH. Returns a dict
+    with months sorted oldest→newest plus latest/prev rows, or None if the file
+    is absent/unreadable — the dashboard degrades gracefully without it."""
+    try:
+        with open(KPI_DATA_PATH, "r") as f:
+            raw = json.load(f)
+    except (OSError, ValueError):
+        return None
+    months = raw.get("months", []) or []
+    # The file is stored newest-first; sort oldest→newest for charting.
+    months_sorted = sorted(months, key=lambda m: m.get("sort_key") or m.get("month") or "")
+    # "latest"/"prev" track the most recent months that actually carry business
+    # metrics (MRR), so a freshly-inserted current month holding only live
+    # platform views doesn't blank the MRR / members / retention tiles.
+    biz = [m for m in months_sorted if m.get("mrr")]
+    latest = biz[-1] if biz else (months_sorted[-1] if months_sorted else {})
+    prev = biz[-2] if len(biz) >= 2 else {}
+    return {
+        "current_subs": raw.get("current_subs"),
+        "current_total_views": raw.get("current_total_views"),
+        "pulled_at": raw.get("pulled_at"),
+        "months": months_sorted,
+        "latest": latest,
+        "prev": prev,
+        "mrr_goal": DASHBOARD_MRR_GOAL,
+    }
