+def _yt_analytics_client():
+    """Build a YouTube Analytics v2 client from the OAuth pickle, refreshing the
+    token if expired. Returns None when the libs or pickle are unavailable so the
+    dashboard degrades gracefully."""
+    try:
+        import pickle as _pk
+        from googleapiclient.discovery import build
+        from google.auth.transport.requests import Request as _GReq
+        with open(YT_OAUTH_PICKLE, "rb") as f:
+            creds = _pk.load(f)
+        if getattr(creds, "expired", False) and getattr(creds, "refresh_token", None):
+            creds.refresh(_GReq())
+        return build("youtubeAnalytics", "v2", credentials=creds)
+    except Exception as e:
+        print(f"[dash] YT Analytics unavailable: {e}", flush=True)
+        return None
