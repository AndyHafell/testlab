+def _yt_monthly_views():
+    """Real monthly channel views (all traffic) via the Analytics API. Pulls
+    daily and buckets into months — the month dimension rejects non-aligned end
+    dates, and daily includes the partial current month. {'YYYY-MM': views}."""
+    yta = _yt_analytics_client()
+    if yta is None:
+        return {}
+    from datetime import date
+    try:
+        resp = yta.reports().query(
+            ids="channel==MINE", startDate="2022-01-01", endDate=date.today().isoformat(),
+            metrics="views", dimensions="day", sort="day",
+        ).execute()
+    except Exception as e:
+        print(f"[dash] YT monthly query failed: {e}", flush=True)
+        return {}
+    out = {}
+    for row in resp.get("rows", []):
+        ym = row[0][:7]
+        out[ym] = out.get(ym, 0) + int(row[1])
+    return out
