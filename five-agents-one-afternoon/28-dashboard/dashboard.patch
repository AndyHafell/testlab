+def _dash_videos(conn, uid):
+    """Full per-video list (freshest counts) from my_channel_videos, plus the
+    channel view-count median used for outlier scoring."""
+    rows = conn.execute(
+        "SELECT video_id, title, view_count, like_count, comment_count, "
+        "published_at, duration_seconds, thumbnail_url FROM my_channel_videos WHERE user_id = ?",
+        (uid,),
+    ).fetchall()
+    median = _dash_median([r["view_count"] or 0 for r in rows])
+    out = []
+    for r in rows:
+        vc = r["view_count"] or 0
+        out.append({
+            "id": r["video_id"],
+            "title": r["title"] or "",
+            "views": vc,
+            "likes": r["like_count"] or 0,
+            "comments": r["comment_count"] or 0,
+            "published": (r["published_at"] or "")[:10],
+            "duration": r["duration_seconds"] or 0,
+            "thumb": r["thumbnail_url"] or "",
+            "outlier": round(vc / median, 2) if median else 0,
+        })
+    out.sort(key=lambda v: v["views"], reverse=True)
+    return out, median
