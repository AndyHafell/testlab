+# ── External-source cache ─────────────────────────────────────────────────
+# Wraps every outbound API pull (YouTube Analytics, GitHub, Airtable) so the
+# 45s auto-poll on /api/dashboard doesn't hammer external services. Each worker
+# keeps its own cache; Refresh forces a fresh pull (force=True).
+_DASH_CACHE = {}  # key -> (expires_epoch, value)
+
+
+def _dash_cached(key, ttl, producer, force=False):
+    now = time.time()
+    if not force:
+        hit = _DASH_CACHE.get(key)
+        if hit and hit[0] > now:
+            return hit[1]
+    try:
+        val = producer()
+    except Exception as e:
+        print(f"[dash-cache] {key} failed: {e}", flush=True)
+        hit = _DASH_CACHE.get(key)
+        return hit[1] if hit else None
+    _DASH_CACHE[key] = (now + ttl, val)
+    return val
