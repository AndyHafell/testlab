+body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
+.bg-glow{position:fixed;inset:0;z-index:-1;background:
+  radial-gradient(900px 480px at 12% -8%,rgba(255,71,87,.085),transparent 64%),
+  radial-gradient(820px 540px at 96% 12%,rgba(167,139,250,.065),transparent 60%),
+  radial-gradient(700px 600px at 50% 110%,rgba(45,212,191,.05),transparent 60%)}
+main{max-width:1180px;margin:0 auto;padding:0 28px 64px;display:flex;flex-direction:column;gap:50px}
+.num{font-variant-numeric:tabular-nums}
+
+/* topbar */
+.topbar{max-width:1180px;margin:0 auto;padding:24px 28px 32px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
+.brand{display:flex;align-items:center;gap:14px}
+.logo{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-weight:800;font-size:19px;color:#fff;background:linear-gradient(135deg,#ff4757,#b3265f);box-shadow:0 4px 24px rgba(255,71,87,.35)}
+.brand h1{font-size:19px;font-weight:700;letter-spacing:-.02em}
+.brand .sub{font-size:12px;color:var(--muted)}
+.topbar-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
+.pill{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;border:1px solid var(--border);border-radius:999px;background:var(--surface);font-size:12px;color:var(--muted);white-space:nowrap}
+.back-link{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--text);font-size:13px;font-weight:600;text-decoration:none;transition:background .2s,border-color .2s}
+.back-link:hover{background:var(--surface-2);border-color:var(--border-strong)}
+.refresh-btn{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(52,211,153,.4);background:rgba(52,211,153,.1);color:#9ff0cf;font:inherit;font-size:13px;font-weight:650;padding:8px 15px;border-radius:10px;cursor:pointer;transition:background .2s,transform .15s}
+.refresh-btn:hover{background:rgba(52,211,153,.2);transform:translateY(-1px)}
+.refresh-btn:disabled{opacity:.6;cursor:wait}
+.refresh-btn .spin{display:inline-block;width:12px;height:12px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%}
+.refresh-btn.loading .spin{animation:spin .7s linear infinite}
+@keyframes spin{to{transform:rotate(360deg)}}
+.live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 0 rgba(52,211,153,.5);animation:pulse 2.2s ease-out infinite}
+@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(52,211,153,.45)}70%{box-shadow:0 0 0 7px rgba(52,211,153,0)}100%{box-shadow:0 0 0 0 rgba(52,211,153,0)}}
+
+.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}
+.reveal.in{opacity:1;transform:none}
+.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:18px;flex-wrap:wrap}
+.section-head h2{font-size:21px;font-weight:700;letter-spacing:-.02em}
+.section-sub{color:var(--muted);font-size:13px;margin-top:3px}
+.muted{color:var(--muted);font-size:12px}
+.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);backdrop-filter:blur(8px)}
+
+/* hero */
+.hero-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
+.tile{position:relative;overflow:hidden;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px 20px 18px;display:flex;flex-direction:column;gap:6px;transition:transform .25s ease,border-color .25s ease}
+.tile:hover{transform:translateY(-3px);border-color:var(--border-strong)}
+.tile::before{content:"";position:absolute;top:0;left:0;right:0;height:2px;opacity:.9;background:linear-gradient(90deg,var(--accent,var(--red)),transparent 80%)}
+.tile-label{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
+.tile-num{font-size:30px;font-weight:750;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.1}
+.tile-sub{font-size:12px;color:var(--faint);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
+.spark{position:absolute;right:14px;bottom:12px;width:96px;height:30px;opacity:.85}
+.chip{display:inline-flex;align-items:center;font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;padding:2px 7px;border-radius:999px}
+.chip.up{color:#bdf0cc;background:rgba(52,211,153,.14)}
+.chip.dn{color:#f2c0c0;background:rgba(255,71,87,.14)}
+.chip.flat{color:var(--muted);background:rgba(255,255,255,.05)}
+
+/* segmented control */
+.seg{display:inline-flex;padding:3px;gap:2px;border:1px solid var(--border);border-radius:10px;background:var(--surface)}
+.seg-btn{border:0;background:transparent;color:var(--muted);font:inherit;font-size:12.5px;font-weight:600;padding:7px 13px;border-radius:8px;cursor:pointer;transition:background .2s,color .2s}
+.seg-btn:hover{color:var(--text)}
+.seg-btn.active{background:var(--surface-2);color:var(--text);box-shadow:inset 0 0 0 1px var(--border)}
+
+/* chart */
+.chart-card{padding:22px 22px 12px}
+.chart-wrap{position:relative;height:300px}
+.chart-wrap svg{display:block;width:100%;height:100%;overflow:visible}
+.axis-label{fill:var(--faint);font-size:11px;font-variant-numeric:tabular-nums}
+.grid-line{stroke:rgba(255,255,255,.055);stroke-dasharray:3 5}
+.chart-area{opacity:0;animation:fadeIn .9s ease .5s forwards}
+@keyframes fadeIn{to{opacity:1}}
+.chart-bar{transform-box:fill-box;transform-origin:bottom;animation:barGrow .7s cubic-bezier(.22,1,.36,1) both}
+@keyframes barGrow{from{transform:scaleY(0)}to{transform:scaleY(1)}}
+.crosshair{stroke:rgba(255,255,255,.22);stroke-width:1}
+.hover-dot{filter:drop-shadow(0 0 5px currentColor)}
+.chart-tip{position:fixed;z-index:50;pointer-events:none;background:rgba(16,16,23,.95);border:1px solid var(--border-strong);border-radius:10px;padding:9px 12px;font-size:12px;color:var(--muted);box-shadow:0 10px 32px rgba(0,0,0,.55);white-space:nowrap}
+.chart-tip b{display:block;color:var(--text);font-size:12.5px;margin-bottom:2px}
+.stat-strip{display:flex;flex-wrap:wrap;gap:0 36px;padding:16px 4px 10px;border-top:1px solid var(--border);margin-top:14px}
+.strip-item{padding:4px 0}
+.strip-item .k{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--faint);display:block}
+.strip-item .v{font-size:16px;font-weight:650;font-variant-numeric:tabular-nums}
+
+/* north-star */
+.northstar{margin-top:14px;border-top:1px solid var(--border);padding-top:16px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
+.northstar .lab{font-size:11px;color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.08em}
+.northstar .big{font-size:18px;font-weight:750}
+.northstar .barwrap{flex:1;min-width:220px}
+.northstar .track{height:10px;border-radius:999px;background:rgba(255,255,255,.06);overflow:hidden;border:1px solid var(--border)}
+.northstar .fill{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#e8a800,var(--gold));transition:width 1.3s cubic-bezier(.2,.7,.2,1)}
+.northstar .scale{display:flex;justify-content:space-between;color:var(--faint);font-size:11px;margin-top:5px}
+
+/* results checker */
+.pending-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-bottom:14px}
+.pending-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;display:flex;flex-direction:column;gap:12px;transition:border-color .3s,box-shadow .3s}
+.pending-card .v-title{font-size:14px;font-weight:600;line-height:1.35}
+.pending-card .v-meta{font-size:12px;color:var(--faint)}
+.check-btn{align-self:flex-start;border:1px solid rgba(255,71,87,.45);background:var(--red-soft);color:#ff8c97;font:inherit;font-size:12.5px;font-weight:650;padding:8px 16px;border-radius:9px;cursor:pointer;transition:background .2s,transform .15s}
+.check-btn:hover{background:rgba(255,71,87,.24);transform:translateY(-1px)}
+.check-btn:disabled{opacity:.55;cursor:wait}
+.pending-card.done{border-color:rgba(52,211,153,.45);box-shadow:0 0 0 1px rgba(52,211,153,.25),0 8px 30px rgba(52,211,153,.07)}
+.result-row{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
+.result-views{font-size:26px;font-weight:750;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
+.vs-median{font-size:12px;color:var(--faint)}
+.badge{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px;letter-spacing:.04em}
+.badge-done{background:rgba(52,211,153,.13);color:var(--green);border:1px solid rgba(52,211,153,.35)}
+.empty-note{grid-column:1/-1;padding:26px;text-align:center;color:var(--faint);border:1px dashed var(--border);border-radius:var(--radius);font-size:13px}
+.archive-card{padding:18px 22px;margin-top:2px}
+.archive-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px}
+.archive-head h3{font-size:14px;font-weight:700}
+.archive-row{display:grid;grid-template-columns:1fr auto auto auto;gap:18px;align-items:center;padding:11px 2px;border-top:1px solid var(--border);font-size:13px;animation:rowIn .45s ease both}
+@keyframes rowIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
+.archive-row .a-title{font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.archive-row .a-views{font-variant-numeric:tabular-nums;font-weight:650}
+.archive-row .a-date{color:var(--faint);font-size:12px}
+
+/* outlier chips */
+.t-fire{color:var(--gold);background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.35)}
+.t-high{color:var(--green);background:rgba(52,211,153,.11);border:1px solid rgba(52,211,153,.3)}
+.t-mid{color:var(--blue);background:rgba(79,141,249,.12);border:1px solid rgba(79,141,249,.3)}
+.t-low{color:var(--faint);background:rgba(255,255,255,.04);border:1px solid var(--border)}
+
+/* table */
+.search{background:var(--surface);border:1px solid var(--border);border-radius:10px;color:var(--text);font:inherit;font-size:13px;padding:9px 14px;width:240px;outline:none;transition:border-color .2s}
+.search:focus{border-color:var(--border-strong)}
