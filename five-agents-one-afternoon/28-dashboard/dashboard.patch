+    hdr = {"User-Agent": "cg-dashboard", "Accept": "application/vnd.github+json"}
+    if tok:
+        hdr["Authorization"] = f"Bearer {tok}"
+
+    def _get(url):
+        return json.loads(urlopen(Request(url, headers=hdr), timeout=20).read())
+
+    try:
+        u = _get(f"https://api.github.com/users/{user}")
+    except Exception as e:
+        print(f"[dash] github user failed: {e}", flush=True)
+        return None
+    repos, page = [], 1
+    while page <= 5:
+        try:
+            url = (f"https://api.github.com/user/repos?per_page=100&page={page}&affiliation=owner&sort=updated"
+                   if tok else
+                   f"https://api.github.com/users/{user}/repos?per_page=100&page={page}&sort=updated")
+            batch = _get(url)
+        except Exception as e:
+            print(f"[dash] github repos failed: {e}", flush=True)
+            break
+        if not batch:
+            break
+        for r in batch:
+            repos.append({"name": r.get("name"), "stars": r.get("stargazers_count", 0)})
+        if len(batch) < 100:
+            break
+        page += 1
