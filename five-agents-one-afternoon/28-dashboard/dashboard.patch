+def _dash_monthly(videos):
+    """Videos + views per publish-month, gap-filled oldest→newest (honest zeros)."""
+    agg = {}
+    for v in videos:
+        ym = v["published"][:7]
+        if len(ym) != 7:
+            continue
+        a = agg.setdefault(ym, {"videos": 0, "views": 0})
+        a["videos"] += 1
+        a["views"] += v["views"]
+    if not agg:
+        return []
+
+    def _idx(m):
+        y, mo = m.split("-")
+        return int(y) * 12 + int(mo) - 1
+
+    keys = sorted(agg)
+    out, i, last = [], _idx(keys[0]), _idx(keys[-1])
+    while i <= last:
+        ym = f"{i // 12:04d}-{i % 12 + 1:02d}"
+        a = agg.get(ym, {"videos": 0, "views": 0})
+        out.append({"month": ym, "videos": a["videos"], "views": a["views"]})
+        i += 1
+    return out
