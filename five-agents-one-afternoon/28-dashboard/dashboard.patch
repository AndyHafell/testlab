+# ── Skool members (live from the Airtable auto-tracker) ─────────────────────
+def _airtable_members():
+    """Live Skool roster from the Mate OS auto-tracker, piped straight into the
+    dashboard. Dedupes by lowercased email (newest by JoinedDate), then returns
+    counts (total active / paying / free / cancelled / legacy), new-joiner counts
+    (7d/30d), the '#1 focus' breakdown (Answer1), and the full roster for the
+    Members tab. The Zap is create-only so this is best-effort — labelled
+    'from auto-tracker', not a verified live Skool count."""
+    from urllib.request import urlopen, Request
+    from datetime import date, timedelta
+    tok = os.environ.get("AIRTABLE_PERSONAL_ACCESS_TOKEN") or os.environ.get("AIRTABLE_TOKEN", "")
+    if not tok:
+        return None
+    base = os.environ.get("AIRTABLE_MEMBER_BASE", "PLACEHOLDER_AIRTABLE_BASE")
+    table = os.environ.get("AIRTABLE_MEMBER_TABLE", "PLACEHOLDER_AIRTABLE_TABLE")
+    hdr = {"Authorization": f"Bearer {tok}", "User-Agent": "cg-dashboard"}
+    rows, offset = [], None
+    try:
+        while True:
+            url = (f"https://api.airtable.com/v0/{base}/{table}?pageSize=100"
+                   "&fields%5B%5D=Name&fields%5B%5D=Status&fields%5B%5D=Answer1"
+                   "&fields%5B%5D=Email&fields%5B%5D=JoinedDate")
+            if offset:
+                url += f"&offset={offset}"
+            resp = json.loads(urlopen(Request(url, headers=hdr), timeout=25).read())
+            rows.extend(resp.get("records", []))
+            offset = resp.get("offset")
+            if not offset:
+                break
+    except Exception as e:
+        print(f"[dash] airtable members failed: {e}", flush=True)
+        return None
+    by_email = {}
+    for r in rows:
+        f = r.get("fields", {})
+        key = (f.get("Email") or "").strip().lower() or r.get("id")
+        joined = f.get("JoinedDate") or ""
+        prev = by_email.get(key)
+        if prev is None or joined >= (prev.get("joined") or ""):
+            by_email[key] = {
+                "name": f.get("Name") or "",
+                "status": f.get("Status") or "",
+                "focus": f.get("Answer1") or "",
+                "email": f.get("Email") or "",
+                "joined": joined,
+            }
+    members = list(by_email.values())
+    members.sort(key=lambda m: m["joined"], reverse=True)
+    statuses = [m["status"] for m in members]
+    cut7 = (date.today() - timedelta(days=7)).isoformat()
+    cut30 = (date.today() - timedelta(days=30)).isoformat()
+    focus = {}
+    for m in members:
+        if m["status"] != "Cancelled" and m["focus"]:
+            focus[m["focus"]] = focus.get(m["focus"], 0) + 1
+    return {
+        "total_active": sum(1 for s in statuses if s != "Cancelled"),
+        "paying": sum(1 for s in statuses if s == "Paid"),
+        "free": sum(1 for s in statuses if s == "Free"),
+        "legacy": sum(1 for s in statuses if s == "Legacy"),
+        "cancelled": sum(1 for s in statuses if s == "Cancelled"),
+        "new_7d": sum(1 for m in members if (m["joined"] or "")[:10] >= cut7),
+        "new_30d": sum(1 for m in members if (m["joined"] or "")[:10] >= cut30),
+        "focus": sorted(focus.items(), key=lambda kv: kv[1], reverse=True),
+        "roster": members[:500],
+        "pulled_at": datetime.now(timezone.utc).isoformat(),
+    }
