+def _yt_windows():
+    """Daily channel views (last ~95d) for the windowed overview chart + the
+    YouTube-Studio-style 28-day KPI cards (views, watch hours, net subs, likes)
+    with a previous-period baseline for 'vs usual' deltas. None when unavailable.
+    (estimatedRevenue needs the monetary OAuth scope the pickle lacks → omitted.)"""
+    yta = _yt_analytics_client()
+    if yta is None:
+        return None
+    from datetime import date, timedelta
+    end = date.today()
+    try:
+        resp = yta.reports().query(
+            ids="channel==MINE", startDate=(end - timedelta(days=95)).isoformat(),
+            endDate=end.isoformat(), metrics="views", dimensions="day", sort="day",
+        ).execute()
+    except Exception as e:
+        print(f"[dash] YT window query failed: {e}", flush=True)
+        return None
+    series = [{"day": r[0], "views": int(r[1])} for r in resp.get("rows", [])]
+    _tail = lambda n: sum(d["views"] for d in series[-n:])
+
+    def _agg(s, e):
+        try:
+            r = yta.reports().query(
+                ids="channel==MINE", startDate=s.isoformat(), endDate=e.isoformat(),
+                metrics="views,estimatedMinutesWatched,subscribersGained,subscribersLost,likes",
+            ).execute()
+            row = (r.get("rows") or [[0, 0, 0, 0, 0]])[0]
+            return {"views": int(row[0]), "watch_hours": round(int(row[1]) / 60),
+                    "subs_net": int(row[2]) - int(row[3]), "likes": int(row[4])}
+        except Exception as ex:
+            print(f"[dash] YT studio agg failed: {ex}", flush=True)
+            return None
+
+    cur = _agg(end - timedelta(days=28), end)
+    prev = _agg(end - timedelta(days=56), end - timedelta(days=28))
+    return {"d7": _tail(7), "d28": _tail(28), "d30": _tail(30), "d90": _tail(90),
+            "series": series[-90:], "studio": {"cur": cur, "prev": prev}}
