+<style>
+:root{
+  --bg:#07070b; --surface:rgba(255,255,255,.027); --surface-2:rgba(255,255,255,.05);
+  --border:rgba(255,255,255,.075); --border-strong:rgba(255,255,255,.14);
+  --text:#f2f3f7; --muted:#8b8e9e; --faint:#5b5e6e;
+  --red:#ff4757; --red-soft:rgba(255,71,87,.14); --violet:#a78bfa; --blue:#4f8df9;
+  --cyan:#2dd4bf; --gold:#fbbf24; --green:#34d399; --radius:16px;
+  --font:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter","Segoe UI",sans-serif;
+}
+*{box-sizing:border-box;margin:0;padding:0}
