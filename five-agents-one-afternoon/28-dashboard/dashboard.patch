+def _meta_pull_ig_fb():
+    """Live Instagram + Facebook current-month views via the Meta Graph API.
+    Returns (ig_views, fb_views); either is None when unavailable. Ported from
+    the analyticsmate kpi_refresh.py."""
+    import ssl
+    from urllib.request import urlopen, Request
+    token = os.environ.get("META_ACCESS_TOKEN", "")
+    if not token:
+        return None, None
+    ig_id = os.environ.get("META_IG_ACCOUNT_ID", "PLACEHOLDER_IG_ACCOUNT_ID")
+    page_id = os.environ.get("META_FB_PAGE_ID", "1512666705493261")
+    ctx = ssl.create_default_context()
+    now = datetime.now(timezone.utc)
+    since = now.replace(day=1).strftime("%Y-%m-%d")
+    until = now.strftime("%Y-%m-%d")
+    ig = fb = None
+
+    def _err(e):
+        try:
+            return e.read().decode("utf-8", "ignore")[:240]
+        except Exception:
+            return str(e)
+
+    try:
+        # IG account-level "views" (Meta v25 uses metric_type=total_value).
+        url = (f"https://graph.facebook.com/v25.0/{ig_id}/insights"
+               f"?metric=views&metric_type=total_value&period=day"
+               f"&since={since}&until={until}&access_token={token}")
+        resp = json.loads(urlopen(Request(url), context=ctx, timeout=30).read())
+        data = resp.get("data", [])
+        if data:
+            tv = data[0].get("total_value")
+            if tv is not None:
+                ig = tv.get("value", 0)
+            else:
+                ig = sum(v.get("value", 0) for v in data[0].get("values", []))
+    except Exception as e:
+        print(f"[dash-refresh] IG pull failed: {_err(e)}", flush=True)
+    try:
+        purl = f"https://graph.facebook.com/v25.0/{page_id}?fields=access_token&access_token={token}"
+        ptok = json.loads(urlopen(Request(purl), context=ctx, timeout=15).read()).get("access_token", "")
+        if ptok:
+            url = (f"https://graph.facebook.com/v25.0/{page_id}/video_reels"
+                   f"?fields=id,created_time,views&limit=100&access_token={ptok}")
+            resp = json.loads(urlopen(Request(url), context=ctx, timeout=30).read())
+            cm = now.strftime("%Y-%m")
+            fb = sum(r.get("views", 0) for r in resp.get("data", []) if r.get("created_time", "")[:7] == cm)
+    except Exception as e:
+        print(f"[dash-refresh] FB pull failed: {_err(e)}", flush=True)
+    return ig, fb
