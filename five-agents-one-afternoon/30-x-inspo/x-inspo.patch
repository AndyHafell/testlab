+def x_outlier_score(like_count, followers) -> float:
+    """Engagement-outlier for an X post — the parallel to YouTube's
+    view_count / channel_avg_views. Scaled so ~6% of followers liking → 3.0x
+    ("hot") and ~3% → 1.5x ("warm"), matching the existing badge thresholds.
+    Unknown followers or zero likes → 0.0 (no badge)."""
+    try:
+        like_count = int(like_count or 0)
+        followers = int(followers or 0)
+    except (TypeError, ValueError):
+        return 0.0
+    if like_count <= 0 or followers <= 0:
+        return 0.0
+    return round(like_count / followers * 50, 1)
+
+
+def _parse_x_date(s: str) -> str:
+    """twitterapi.io createdAt ('Sat Jun 13 00:50:03 +0000 2026') → ISO-8601 Z."""
+    if not s:
+        return ""
+    try:
+        dt = datetime.strptime(s, "%a %b %d %H:%M:%S %z %Y")
+        return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    except (ValueError, TypeError):
+        return ""
+
+
+def tweet_to_video_meta(t: dict) -> dict:
+    """Map a twitterapi.io tweet object onto the same dict shape
+    fetch_tweet_metadata() returns, so the existing X-as-video ingest path can
+    consume it unchanged. thumbnail_url is intentionally left blank here — it is
+    filled with the generated credit-card tile at ingest time."""
+    t = t or {}
+    author = t.get("author") or {}
+    tweet_id = str(t.get("id") or "")
+
+    title = (t.get("text") or "").strip()
+    if len(title) > 200:
+        title = title[:197] + "..."
+
+    handle = author.get("userName") or ""
+    channel_title = f"@{handle}" if handle else (author.get("name") or "X")
+    followers = int(author.get("followers") or 0)
+    like_count = int(t.get("likeCount") or 0)
+    view_count = int(t.get("viewCount") or 0)
+    canonical_url = t.get("url") or (
+        f"https://x.com/{handle}/status/{tweet_id}" if handle
+        else f"https://x.com/i/status/{tweet_id}"
+    )
+    published_at = _parse_x_date(t.get("createdAt") or "")
+
+    media_all = ((t.get("extendedEntities") or {}).get("media")) or []
+    media = [
+        {
+            "url": m.get("media_url_https") or m.get("media_url") or "",
+            "thumbnail_url": m.get("media_url_https") or m.get("media_url") or "",
+            "type": m.get("type") or "",
+        }
+        for m in media_all
+    ]
+
+    return {
+        "video_id": f"x_{tweet_id}",
+        "title": title or "(tweet)",
+        "channel_title": channel_title,
+        "channel_thumb": author.get("profilePicture") or "",
+        "thumbnail_url": "",
+        "view_count": view_count,
+        "duration": "",
+        "published_at": published_at,
+        "outlier_score": x_outlier_score(like_count, followers),
+        "channel_avg_views": followers,
+        "_source": {
+            "platform": "x",
+            "url": canonical_url,
+            "text": (t.get("text") or "").strip(),
+            "author_name": author.get("name") or "",
+            "author_handle": handle,
+            "author_avatar": author.get("profilePicture") or "",
+            "created_at": published_at,
+            "views": view_count,
+            "likes": like_count,
+            "retweets": int(t.get("retweetCount") or 0),
+            "replies": int(t.get("replyCount") or 0),
+            "quotes": int(t.get("quoteCount") or 0),
+            "followers": followers,
+            "media": media,
+        },
+    }
+
