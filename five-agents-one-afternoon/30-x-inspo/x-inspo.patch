+@app.route("/api/x-creators", methods=["POST"])
+def add_x_creator():
+    uid, err = _x_inspo_guard()
+    if err:
+        return err
+    data = request.get_json(force=True) or {}
+    handle = (data.get("handle") or "").strip().lstrip("@")
+    # Tolerate a pasted profile URL (x.com/handle, twitter.com/handle).
+    m = re.search(r"(?:x|twitter)\.com/([A-Za-z0-9_]+)", handle)
+    if m:
+        handle = m.group(1)
+    handle = handle.strip("/").split("/")[0]
+    if not handle:
+        return jsonify({"error": "No handle provided"}), 400
+    conn = get_db()
+    if conn.execute(
+        "SELECT 1 FROM x_creators WHERE lower(handle) = lower(?) AND user_id = ?",
+        (handle, uid),
+    ).fetchone():
+        conn.close()
+        return jsonify({"error": "Creator already added"}), 409
+    conn.execute(
+        "INSERT INTO x_creators (handle, user_id) VALUES (?, ?)", (handle, uid)
+    )
+    conn.commit()
+    row = conn.execute(
+        "SELECT * FROM x_creators WHERE lower(handle) = lower(?) AND user_id = ?",
+        (handle, uid),
+    ).fetchone()
+    conn.close()
+    return jsonify(dict(row)), 201
