+"""Unit tests for the X Inspiration feature's pure logic.
+
+These cover the two pure functions that turn a twitterapi.io tweet object into a
+CreatorGrowth `videos`-shaped dict, plus the engagement-outlier math that
+parallels YouTube's view_count / channel_avg_views. No network: we feed a
+representative tweet dict captured from the live API.
+"""
+
+# A representative tweet object in twitterapi.io's shape (trimmed to the fields
+# the mapper reads). Captured from the live advanced_search response.
+SAMPLE_TWEET = {
+    "type": "tweet",
+    "id": "2065597531644743999",
+    "url": "https://x.com/karpathy/status/2065597531644743999",
+    "text": "nanochat: a minimal end-to-end ChatGPT clone in 8000 lines.",
+    "retweetCount": 3400,
+    "replyCount": 412,
+    "likeCount": 21000,
+    "quoteCount": 120,
+    "viewCount": 854742,
+    "bookmarkCount": 900,
+    "createdAt": "Sat Jun 13 00:50:03 +0000 2026",
+    "isReply": False,
+    "conversationId": "2065597531644743999",
+    "author": {
+        "userName": "karpathy",
+        "name": "Andrej Karpathy",
+        "profilePicture": "https://pbs.twimg.com/profile_images/abc_normal.jpg",
+        "followers": 700000,
+        "isBlueVerified": True,
+    },
+    "extendedEntities": {
+        "media": [
+            {"media_url_https": "https://pbs.twimg.com/media/xyz.jpg", "type": "photo"}
+        ]
+    },
+}
+
+
+# ── x_outlier_score ──────────────────────────────────────────────────────────
+
+def test_outlier_score_15x_at_3pct(app_module):
+    # 21000 / 700000 = 3% of followers liked → 1.5x ("warm").
+    assert app_module.x_outlier_score(21000, 700000) == 1.5
+
+
+def test_outlier_score_3x_at_6pct(app_module):
+    # 42000 / 700000 = 6% → 3.0x ("hot").
+    assert app_module.x_outlier_score(42000, 700000) == 3.0
+
+
+def test_outlier_score_zero_followers_is_zero(app_module):
+    # Unknown follower count must not produce an absurd score.
+    assert app_module.x_outlier_score(500, 0) == 0.0
+
+
+def test_outlier_score_zero_likes_is_zero(app_module):
+    assert app_module.x_outlier_score(0, 700000) == 0.0
+
+
+# ── tweet_to_video_meta ──────────────────────────────────────────────────────
+
+def test_meta_video_id_is_x_prefixed(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["video_id"] == "x_2065597531644743999"
+
+
+def test_meta_channel_title_is_at_handle(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["channel_title"] == "@karpathy"
+
+
+def test_meta_title_is_tweet_text(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["title"] == "nanochat: a minimal end-to-end ChatGPT clone in 8000 lines."
+
+
+def test_meta_long_title_truncated(app_module):
+    t = dict(SAMPLE_TWEET, text="x" * 400)
+    meta = app_module.tweet_to_video_meta(t)
+    assert len(meta["title"]) == 200
+    assert meta["title"].endswith("...")
+
+
+def test_meta_view_count(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["view_count"] == 854742
+
+
+def test_meta_channel_avg_views_is_followers(app_module):
+    # Parallels YouTube channel_avg_views — used as the outlier denominator.
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["channel_avg_views"] == 700000
+
+
+def test_meta_outlier_score_matches_helper(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["outlier_score"] == app_module.x_outlier_score(21000, 700000)
+
+
+def test_meta_published_at_is_iso(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["published_at"] == "2026-06-13T00:50:03Z"
+
+
+def test_meta_channel_thumb_is_avatar(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    assert meta["channel_thumb"] == "https://pbs.twimg.com/profile_images/abc_normal.jpg"
+
+
+def test_meta_source_bundle(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    src = meta["_source"]
+    assert src["platform"] == "x"
+    assert src["url"] == "https://x.com/karpathy/status/2065597531644743999"
+    assert src["author_handle"] == "karpathy"
+    assert src["author_name"] == "Andrej Karpathy"
+    assert src["likes"] == 21000
+    assert src["retweets"] == 3400
+    assert src["replies"] == 412
+    assert src["views"] == 854742
+    assert src["followers"] == 700000
+
+
+def test_meta_source_media(app_module):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    media = meta["_source"]["media"]
+    assert len(media) == 1
+    assert media[0]["url"] == "https://pbs.twimg.com/media/xyz.jpg"
+
+
+def test_meta_handles_missing_author(app_module):
+    # A malformed tweet with no author must not crash the mapper.
+    t = {"id": "123", "text": "hi", "likeCount": 5}
+    meta = app_module.tweet_to_video_meta(t)
+    assert meta["video_id"] == "x_123"
+    assert meta["channel_avg_views"] == 0
+    assert meta["outlier_score"] == 0.0
+
+
+# ── generate_x_card_image (the premium credit-card tile) ─────────────────────
+
+def test_card_image_is_valid_16x9_png(app_module, tmp_path):
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    out = tmp_path / "x_card.png"
+    app_module.generate_x_card_image(meta, str(out))
+    assert out.exists() and out.stat().st_size > 0
+    from PIL import Image
+    with Image.open(out) as im:
+        assert im.format == "PNG"
+        assert im.size == (1200, 675)  # 16:9, fits the YouTube card slot
+
+
+def test_card_image_no_network_avatar_fallback(app_module, tmp_path):
+    # With avatar_img=None the renderer must draw a fallback and never fetch.
+    meta = app_module.tweet_to_video_meta(SAMPLE_TWEET)
+    out = tmp_path / "x_card_noavatar.png"
+    app_module.generate_x_card_image(meta, str(out), avatar_img=None)
+    assert out.exists() and out.stat().st_size > 0
+
+
+def test_card_image_handles_minimal_meta(app_module, tmp_path):
+    # No author, no metrics — must still produce a valid tile, not crash.
+    minimal = app_module.tweet_to_video_meta({"id": "9", "text": "hi"})
+    out = tmp_path / "min.png"
+    app_module.generate_x_card_image(minimal, str(out))
+    assert out.exists() and out.stat().st_size > 0
+
+
+# ── routes: X creators + pull + keyword search ──────────────────────────────
+#
+# These stub the twitterapi.io calls and the (heavy, network-touching) image
+# generation so the route logic is exercised offline. The real wrappers and
+# renderer are covered by the unit tests above.
+
+def _stub_x_io(monkeypatch, app_module):
+    monkeypatch.setattr(app_module, "_fetch_avatar_image", lambda *a, **k: None)
+    monkeypatch.setattr(app_module, "generate_x_card_image",
+                        lambda meta, path, **k: path)
+
+
+def _admin_login(app_module, monkeypatch, seed_user, login_as, email):
+    """Seed + log in an allowlisted user AND mark them admin. X Inspiration is
+    admin-gated (Andy dogfoods on real data), so every happy-path route test
+    needs an admin session."""
+    seed_user(email, email.split("@")[0])
+    monkeypatch.setattr(app_module, "ADMIN_EMAILS",
+                        set(app_module.ADMIN_EMAILS) | {email.lower()})
+    login_as(email)
+
+
+def test_x_creators_requires_auth(client):
+    assert client.get("/api/x-creators").status_code == 401
+
+
+def test_x_routes_require_admin(client, seed_user, login_as):
+    # Authenticated but NOT an admin → gated out everywhere (feature is admin-only).
+    seed_user("nonadmin@example.com", "nonadmin")
+    login_as("nonadmin@example.com")
+    assert client.get("/api/x-creators").status_code == 403
+    assert client.post("/api/x-creators", json={"handle": "x"}).status_code == 403
+    assert client.post("/api/x-inspiration/search",
+                       json={"query": "x"}).status_code == 403
+
