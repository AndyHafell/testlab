+def _resolve_font(size: int, bold: bool = False):
+    """Load a TrueType font, trying macOS (local :5051) then Linux (VPS/DejaVu)
+    paths, falling back to PIL's bitmap default so rendering never hard-fails."""
+    from PIL import ImageFont
+    if bold:
+        candidates = [
+            "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
+            "/Library/Fonts/Arial Bold.ttf",
+            "/System/Library/Fonts/Helvetica.ttc",
+            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+            "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
+            "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf",
+        ]
+    else:
+        candidates = [
+            "/System/Library/Fonts/Supplemental/Arial.ttf",
+            "/Library/Fonts/Arial.ttf",
+            "/System/Library/Fonts/Helvetica.ttc",
+            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+            "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+            "/usr/share/fonts/dejavu/DejaVuSans.ttf",
+        ]
+    for fp in candidates:
+        try:
+            return ImageFont.truetype(fp, size)
+        except (OSError, IOError):
+            continue
+    return ImageFont.load_default()
+
+
+def _humanize_count(n) -> str:
+    """21000 → '21K', 854742 → '855K', 1_400_000 → '1.4M'."""
+    try:
+        n = int(n or 0)
+    except (TypeError, ValueError):
+        return "0"
+    if n >= 1_000_000:
+        return f"{n / 1_000_000:.1f}M".replace(".0M", "M")
+    if n >= 1_000:
+        return f"{n / 1_000:.1f}K".replace(".0K", "K")
+    return str(n)
+
+
+def _draw_centered(draw, text, center, font, fill):
+    bbox = draw.textbbox((0, 0), text, font=font)
+    w = bbox[2] - bbox[0]
+    h = bbox[3] - bbox[1]
+    cx, cy = center
+    draw.text((cx - w / 2 - bbox[0], cy - h / 2 - bbox[1]), text, font=font, fill=fill)
+
+
+def _wrap_text(draw, text, font, max_width, max_lines=4):
+    """Greedy word-wrap to a pixel width, capped at max_lines with an ellipsis."""
+    words = (text or "").replace("\n", " ").split()
+    lines, cur, hit_limit = [], "", False
+    for w in words:
+        trial = (cur + " " + w).strip()
+        if not cur or draw.textlength(trial, font=font) <= max_width:
+            cur = trial
+        else:
+            lines.append(cur)
+            cur = w
+            if len(lines) == max_lines:
+                hit_limit = True
+                break
+    if not hit_limit and cur:
+        lines.append(cur)
+    lines = lines[:max_lines]
+    if hit_limit and lines:
+        last = lines[-1]
+        while last and draw.textlength(last + "…", font=font) > max_width:
+            last = last[:-1]
+        lines[-1] = (last + "…") if last else "…"
+    return lines
+
