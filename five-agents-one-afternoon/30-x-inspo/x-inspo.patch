+def _pull_one_x_creator(conn, uid, row, limit=12, min_likes=0):
+    """Pull a single creator's recent posts into Ideas. Updates the creator's
+    cached name/avatar/followers from the response. Returns count added."""
+    tweets = twitterapi_user_tweets(row["handle"])
+    added = _rank_and_ingest_tweets(conn, uid, tweets, limit=limit, min_likes=min_likes)
+    # Refresh the creator's display fields from the first tweet's author.
+    author = (tweets[0].get("author") if tweets else None) or {}
+    conn.execute(
+        "UPDATE x_creators SET name = ?, avatar = ?, followers = ?, "
+        "last_pulled = datetime('now') WHERE id = ?",
+        (author.get("name") or row["name"] or "",
+         author.get("profilePicture") or row["avatar"] or "",
+         int(author.get("followers") or row["followers"] or 0),
+         row["id"]),
+    )
+    conn.commit()
+    return added
+
+
+@app.route("/api/x-creators/<int:cid>/pull", methods=["POST"])
+def pull_x_creator(cid):
+    uid, err = _x_inspo_guard()
+    if err:
+        return err
+    conn = get_db()
+    row = conn.execute(
+        "SELECT * FROM x_creators WHERE id = ? AND user_id = ?", (cid, uid)
+    ).fetchone()
+    if not row:
+        conn.close()
+        return jsonify({"error": "Not found"}), 404
+    added = _pull_one_x_creator(conn, uid, row)
+    conn.close()
+    return jsonify({"ok": True, "added": added})
+
+
+@app.route("/api/x-creators/pull-all", methods=["POST"])
+def pull_all_x_creators():
+    uid, err = _x_inspo_guard()
+    if err:
+        return err
+    conn = get_db()
+    rows = conn.execute(
+        "SELECT * FROM x_creators WHERE user_id = ?", (uid,)
+    ).fetchall()
+    total = 0
+    for row in rows:
+        total += _pull_one_x_creator(conn, uid, row)
+    conn.close()
+    return jsonify({"ok": True, "added": total, "creators": len(rows)})
+
+
+@app.route("/api/x-inspiration/search", methods=["POST"])
+def x_inspiration_search():
+    uid, err = _x_inspo_guard()
+    if err:
+        return err
+    data = request.get_json(force=True) or {}
+    query = (data.get("query") or "").strip()
+    if not query:
+        return jsonify({"error": "No query provided"}), 400
+    query_type = data.get("queryType") or "Top"
+    try:
+        min_likes = int(data.get("min_likes") or 0)
+    except (TypeError, ValueError):
+        min_likes = 0
+    try:
+        limit = max(1, min(50, int(data.get("limit") or 12)))
+    except (TypeError, ValueError):
+        limit = 12
+    tweets = twitterapi_search(query, query_type=query_type)
+    conn = get_db()
+    added = _rank_and_ingest_tweets(conn, uid, tweets, limit=limit, min_likes=min_likes)
+    conn.close()
+    return jsonify({"ok": True, "added": added, "found": len(tweets)})
+
