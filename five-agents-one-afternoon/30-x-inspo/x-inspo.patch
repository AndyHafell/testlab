+def _fetch_avatar_image(url: str):
+    """Best-effort avatar fetch for the card tile. Network — called at ingest
+    time, never inside the pure renderer. Returns a PIL.Image or None."""
+    if not url:
+        return None
+    try:
+        from io import BytesIO
+        from PIL import Image
+        req = Request(url, headers={"User-Agent": "Mozilla/5.0 creatorgrowth"})
+        with urlopen(req, timeout=8) as r:
+            data = r.read()
+        return Image.open(BytesIO(data)).convert("RGBA")
+    except Exception:
+        return None
+
+
+def generate_x_card_image(meta: dict, out_path, avatar_img=None) -> str:
+    """Render the premium credit-card tile for an X post → 16:9 PNG at out_path.
+
+    Pure / no network: pass a pre-fetched PIL avatar via `avatar_img`, otherwise
+    a monogram fallback is drawn. The saved image becomes the post's
+    thumbnail_url so it renders like a YouTube card in the Ideas grid."""
+    from PIL import Image, ImageDraw
+    meta = meta or {}
+    src = meta.get("_source") or {}
+    W, H = 1200, 675
+
+    # Gradient background: violet → blue (left to right).
+    top, bot = (124, 58, 237), (37, 99, 235)
+    img = Image.new("RGB", (W, H))
+    gd = ImageDraw.Draw(img)
+    for x in range(W):
+        t = x / (W - 1)
+        gd.line(
+            [(x, 0), (x, H)],
+            fill=(
+                int(top[0] + (bot[0] - top[0]) * t),
+                int(top[1] + (bot[1] - top[1]) * t),
+                int(top[2] + (bot[2] - top[2]) * t),
+            ),
+        )
+    img = img.convert("RGBA")
+
+    # Inner translucent card panel (the "credit card").
+    overlay = Image.new("RGBA", (W, H), (0, 0, 0, 0))
+    m = 54
+    ImageDraw.Draw(overlay).rounded_rectangle(
+        [m, m, W - m, H - m], radius=40, fill=(255, 255, 255, 28)
+    )
+    img = Image.alpha_composite(img, overlay)
+    draw = ImageDraw.Draw(img)
+
+    pad = m + 40
+    handle = (src.get("author_handle") or "").strip()
+    name = (src.get("author_name") or "").strip()
+
+    # Header: avatar (or monogram) + @handle + name.
+    av_size, ax, ay = 96, pad, pad
+    drew_avatar = False
+    if avatar_img is not None:
+        try:
+            av = avatar_img.convert("RGBA").resize((av_size, av_size))
+            mask = Image.new("L", (av_size, av_size), 0)
+            ImageDraw.Draw(mask).ellipse([0, 0, av_size, av_size], fill=255)
+            img.paste(av, (ax, ay), mask)
+            draw = ImageDraw.Draw(img)
+            drew_avatar = True
+        except Exception:
+            drew_avatar = False
+    if not drew_avatar:
+        draw.ellipse([ax, ay, ax + av_size, ay + av_size], fill=(255, 255, 255, 70))
+        letter = (handle[:1] or name[:1] or "X").upper()
+        _draw_centered(
+            draw, letter, (ax + av_size / 2, ay + av_size / 2),
+            _resolve_font(54, bold=True), (255, 255, 255, 255),
+        )
+
+    hx = ax + av_size + 28
+    draw.text((hx, ay + 4), f"@{handle}" if handle else (name or "X"),
+              font=_resolve_font(46, bold=True), fill=(255, 255, 255, 255))
+    if name and handle:
+        draw.text((hx, ay + 58), name[:34],
+                  font=_resolve_font(28, bold=False), fill=(255, 255, 255, 205))
+
+    # X logo badge, top-right.
+    bs = 64
+    bx2, by1 = W - pad, ay
+    draw.rounded_rectangle([bx2 - bs, by1, bx2, by1 + bs], radius=16,
+                           fill=(15, 15, 20, 235))
+    _draw_centered(draw, "X", (bx2 - bs / 2, by1 + bs / 2),
+                   _resolve_font(44, bold=True), (255, 255, 255, 255))
+
+    # Body: the tweet text, wrapped.
+    body_font = _resolve_font(48, bold=True)
+    lines = _wrap_text(draw, meta.get("title") or src.get("text") or "",
+                       body_font, W - 2 * pad, max_lines=4)
+    by = ay + av_size + 46
+    for ln in lines:
+        draw.text((pad, by), ln, font=body_font, fill=(255, 255, 255, 255))
+        by += 62
+
+    # Bottom metrics row + outlier badge.
+    mf = _resolve_font(34, bold=True)
+    my = H - pad - 38
+    likes = "♥ " + _humanize_count(src.get("likes"))
+    draw.text((pad, my), likes, font=mf, fill=(255, 255, 255, 240))
+    rx = pad + draw.textlength(likes, font=mf) + 40
+    draw.text((rx, my), "RT " + _humanize_count(src.get("retweets")),
+              font=mf, fill=(255, 255, 255, 205))
+
+    score = meta.get("outlier_score") or 0
+    try:
+        score = float(score)
+    except (TypeError, ValueError):
+        score = 0
+    if score > 0:
+        label = f"{score:g}x"
+        pf = _resolve_font(34, bold=True)
+        tw = draw.textlength(label, font=pf)
+        px2, padx = W - pad, 24
+        px1 = px2 - (tw + 2 * padx)
+        py1, py2 = my - 8, my + 46
+        pill = (76, 175, 80, 255) if score >= 3 else (
+            (33, 150, 243, 255) if score >= 1.5 else (90, 90, 110, 255))
+        draw.rounded_rectangle([px1, py1, px2, py2], radius=24, fill=pill)
+        _draw_centered(draw, label, ((px1 + px2) / 2, (py1 + py2) / 2), pf,
+                       (255, 255, 255, 255))
+
+    out_path = str(out_path)
+    d = os.path.dirname(out_path)
+    if d:
+        os.makedirs(d, exist_ok=True)
+    img.convert("RGB").save(out_path, "PNG")
+    return out_path
+
