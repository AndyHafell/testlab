+# ── X Inspiration: discover inspiring posts via twitterapi.io ────────────────
+#
+# Mirrors the YouTube channels → viral-videos flow. Tracked X handles (and ad-hoc
+# keyword searches) pull posts through tweet_to_video_meta() and _ingest_x_tweet()
+# into the `videos` table as Ideas cards with a generated credit-card tile.
+
+def _twitterapi_get(path: str, params: dict, api_key: str | None):
+    """GET a twitterapi.io endpoint and return parsed JSON, or None on failure /
+    missing key. Auth is a single x-api-key header (no OAuth)."""
+    from urllib.parse import urlencode
+    key = api_key or TWITTERAPI_IO_KEY
+    if not key:
+        return None
+    try:
+        url = f"{TWITTERAPI_BASE}{path}?" + urlencode(params)
+        req = Request(url, headers={"x-api-key": key, "User-Agent": "creatorgrowth"})
+        with urlopen(req, timeout=25) as r:
+            return json.loads(r.read().decode("utf-8"))
+    except Exception:
+        return None
+
+
+def twitterapi_search(query, query_type="Top", api_key=None, cursor=""):
+    """Advanced tweet search → list of raw tweet objects (may be empty)."""
+    params = {"query": query, "queryType": query_type}
+    if cursor:
+        params["cursor"] = cursor
+    data = _twitterapi_get("/twitter/tweet/advanced_search", params, api_key)
+    return (data or {}).get("tweets") or []
+
+
+def twitterapi_user_tweets(handle, api_key=None, cursor=""):
+    """A handle's recent tweets → list of raw tweet objects (may be empty)."""
+    params = {"userName": (handle or "").lstrip("@")}
+    if cursor:
+        params["cursor"] = cursor
+    data = _twitterapi_get("/twitter/user/last_tweets", params, api_key) or {}
+    inner = data.get("data") or {}
+    return inner.get("tweets") or data.get("tweets") or []
+
+
+def _ingest_x_tweet(conn, uid: int, meta: dict):
+    """Insert one X post as a `videos` row (+ source bundle) and generate its
+    credit-card tile. Returns the new row id, or None if this user already has it."""
+    if conn.execute(
+        "SELECT 1 FROM videos WHERE video_id = ? AND user_id = ?",
+        (meta["video_id"], uid),
+    ).fetchone():
+        return None
+    tweet_id = meta["video_id"][2:]  # strip "x_"
+    try:
+        out_path = UPLOAD_DIR / "x_cards" / f"{tweet_id}.png"
+        avatar = _fetch_avatar_image(meta.get("channel_thumb") or "")
+        generate_x_card_image(meta, str(out_path), avatar_img=avatar)
+        meta["thumbnail_url"] = f"/static/uploads/x_cards/{tweet_id}.png"
+    except Exception:
+        meta["thumbnail_url"] = meta.get("channel_thumb") or ""
+    conn.execute(
+        """INSERT INTO videos (video_id, title, channel_title, channel_thumb,
+               thumbnail_url, view_count, duration, published_at, status,
+               outlier_score, channel_avg_views, user_id)
+           VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'options', ?, ?, ?)""",
+        (meta["video_id"], meta["title"], meta["channel_title"], meta["channel_thumb"],
+         meta["thumbnail_url"], meta["view_count"], meta["duration"],
+         meta["published_at"], meta["outlier_score"], meta["channel_avg_views"], uid),
+    )
+    row = conn.execute(
+        "SELECT id FROM videos WHERE video_id = ? AND user_id = ?",
+        (meta["video_id"], uid),
+    ).fetchone()
+    if meta.get("_source"):
+        conn.execute(
+            "INSERT INTO video_details (video_id, meta) VALUES (?, ?)",
+            (row["id"], json.dumps({"source": meta["_source"]})),
+        )
+    conn.commit()
+    return row["id"]
+
+
+def _rank_and_ingest_tweets(conn, uid, tweets, limit=12, min_likes=0):
+    """Rank tweets by likes (skipping replies) and ingest the top `limit`."""
+    ranked = sorted(
+        [t for t in (tweets or []) if not t.get("isReply")],
+        key=lambda t: int(t.get("likeCount") or 0),
+        reverse=True,
+    )
+    added = 0
+    for t in ranked:
+        if int(t.get("likeCount") or 0) < min_likes:
+            continue
+        meta = tweet_to_video_meta(t)
+        if meta["video_id"] == "x_":  # malformed (no id)
+            continue
+        if _ingest_x_tweet(conn, uid, meta) is not None:
+            added += 1
+        if added >= limit:
+            break
+    return added
+
+
+def _x_inspo_guard():
+    """X Inspiration is admin-gated (Andy dogfoods on real data). Returns
+    (uid, None) for an admin session, else (None, (response, status))."""
+    uid = _request_user_id()
+    if uid is None:
+        return None, (jsonify({"error": "Unauthorized"}), 401)
+    if not _is_admin_email(session.get("identity_email") or session.get("email", "")):
+        return None, (jsonify({"error": "Admin only"}), 403)
+    return uid, None
+
