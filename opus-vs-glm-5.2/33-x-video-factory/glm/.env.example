# ---- Video Factory secrets ----
# Copy to .env and fill in. ElevenLabs is pre-filled from sos-ep1/1_salesagent/.env.

# ElevenLabs (TTS + Scribe speech-to-text) — HAVE THIS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID

# twitterapi.io — for the live X idea feed (deck falls back to x_ideas.json if unset)
TWITTERAPI_KEY=

# Replicate — for pixverse/lipsync avatar (overlay is static if unset)
REPLICATE_API_TOKEN=

# OpenAI — for the AI voiceover script (gpt-4o-mini-search + o3). Falls back to post text if unset.
OPENAI_API_KEY=

# Local assets
AVATAR_URL=https://drive.google.com/uc?id=1xkFv4authcSs-uRs1Hw-XuFMOq9jHYMy&export=download
MUSIC_PATH=/path/to/your/file
PORT=8124
