+    }
+
+    function wmStatus(state) {
+        const el = wmEl('wmSaveStatus'), txt = wmEl('wmSaveText');
+        el.classList.toggle('error', state === 'error');
+        if (state === 'saving') txt.textContent = 'Saving…';
+        else if (state === 'saved') txt.textContent = 'All changes saved';
+        else if (state === 'error') txt.textContent = 'Couldn’t save — retrying…';
+        else txt.textContent = '';
+    }
+
+    /* ---- toolbar ---- */
+
+    function wmRestoreSel() {
+        const sel = window.getSelection();
+        const ed = wmEl('wmEditor');
+        if (wmLastRange && (!sel.rangeCount || !ed.contains(sel.anchorNode))) {
+            sel.removeAllRanges();
+            sel.addRange(wmLastRange);
+        }
+    }
+
+    function wmExec(cmd, val) {
+        wmEl('wmEditor').focus();
+        wmRestoreSel();
+        document.execCommand(cmd, false, val || null);
+        wmEditorChanged();
+        wmSyncToolbar();
+    }
+
+    function wmBlock(tag) {
+        wmExec('formatBlock', '<' + tag + '>');
+    }
+
+    function wmClearFormat() {
+        wmExec('removeFormat');
+        wmExec('formatBlock', '<p>');
+    }
+
+    function wmSizeStep(dir) {
+        let i = WM_SIZES.indexOf(wmCurSize);
+        if (i === -1) i = WM_SIZES.findIndex(s => s >= wmCurSize);
+        i = Math.max(0, Math.min(WM_SIZES.length - 1, i + dir));
+        wmCurSize = WM_SIZES[i];
+        wmEl('wmSizeBox').textContent = wmCurSize;
+        /* execCommand has no pt sizes — apply size 7 then rewrite to the real pt */
+        wmEl('wmEditor').focus();
+        wmRestoreSel();
+        document.execCommand('fontSize', false, '7');
+        wmEl('wmEditor').querySelectorAll('font[size="7"]').forEach(f => {
+            f.removeAttribute('size');
+            f.style.fontSize = wmCurSize + 'pt';
+        });
+        wmEditorChanged();
+    }
+
+    function wmInsertLink() {
+        let url = prompt('Paste a link:');
+        if (!url) return;
+        if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
+        wmExec('createLink', url);
+    }
+
+    function wmPickImage() {
+        if (!wmVid) return;
+        const sel = window.getSelection();
+        if (sel.rangeCount && wmEl('wmEditor').contains(sel.anchorNode)) {
+            wmLastRange = sel.getRangeAt(0).cloneRange();
+        }
+        wmEl('wmImageInput').click();
+    }
+
+    async function wmUploadImage(input) {
+        const file = input.files && input.files[0];
+        input.value = '';
+        if (!file || !wmVid) return;
+        const fd = new FormData();
+        fd.append('file', file);
+        try {
+            const r = await fetch(`/api/videos/${wmVid}/writing-doc/image`, { method: 'POST', body: fd });
+            const data = await r.json();
+            if (!r.ok) throw new Error(data.error || 'upload failed');
+            wmExec('insertImage', data.url);
+        } catch (e) {
+            showToast('Image upload failed', true);
+        }
+    }
+
+    function wmSetZoom(z) {
+        z = parseFloat(z) || 1;
+        wmEl('wmPageWrap').style.zoom = z;
+        wmEl('wmRuler').style.zoom = z;
+        wmEl('wmRuler').parentElement.style.height = (24 * z) + 'px';
+    }
+
+    function wmPrint() {
+        document.body.classList.add('wm-printing');
+        window.print();
+        setTimeout(() => document.body.classList.remove('wm-printing'), 500);
+    }
+
+    function wmTogglePalette(id) {
+        const pal = wmEl(id);
+        const wasOpen = pal.classList.contains('open');
+        document.querySelectorAll('.wm-palette').forEach(p => p.classList.remove('open'));
+        if (!wasOpen) pal.classList.add('open');
+    }
+
+    function wmBuildPalettes() {
+        const mk = (id, cmd) => {
+            wmEl(id).innerHTML = WM_COLORS.map(c =>
+                `<div class="wm-swatch" style="background:${c}" title="${c}" ` +
+                `onclick="wmExec('${cmd}','${c}');wmTogglePalette('${id}')"></div>`
+            ).join('');
+        };
+        mk('wmColorPal', 'foreColor');
+        mk('wmHilitePal', 'hiliteColor');
+    }
+
+    /* Ruler: 816px = 8.5in page, 1in margins at 96px and 720px, ticks every 1/8in. */
+    function wmBuildRuler() {
+        const r = wmEl('wmRuler');
+        let h = '<div class="wm-ruler-shade" style="left:0;width:96px;"></div>' +
+                '<div class="wm-ruler-shade" style="left:720px;width:96px;"></div>';
+        for (let px = 12; px < 816; px += 12) {
+            const rel = px - 96;
+            if (rel >= 96 && rel % 96 === 0 && px < 720) {
+                h += `<div class="wm-ruler-num" style="left:${px}px;">${rel / 96}</div>`;
+            } else if (rel % 48 === 0) {
+                h += `<div class="wm-ruler-tick half" style="left:${px}px;"></div>`;
+            } else {
+                h += `<div class="wm-ruler-tick" style="left:${px}px;"></div>`;
+            }
+        }
+        h += '<div class="wm-ruler-rect" style="left:96px;"></div>' +
+             '<div class="wm-ruler-tri" style="left:96px;"></div>' +
+             '<div class="wm-ruler-tri" style="left:720px;"></div>';
+        r.innerHTML = h;
+    }
+
+    /* Keep toolbar state (B/I/U, style, font, size, align) in sync with the caret. */
+    function wmSyncToolbar() {
+        if (!wmActive) return;
+        const sel = window.getSelection();
+        const ed = wmEl('wmEditor');
+        if (!sel.rangeCount || !ed.contains(sel.anchorNode)) return;
+        wmLastRange = sel.getRangeAt(0).cloneRange();
+        const st = (id, cmd) => wmEl(id).classList.toggle('active', document.queryCommandState(cmd));
+        st('wmBoldBtn', 'bold'); st('wmItalicBtn', 'italic'); st('wmUnderBtn', 'underline');
+        st('wmAlignL', 'justifyLeft'); st('wmAlignC', 'justifyCenter'); st('wmAlignR', 'justifyRight');
+        let node = sel.anchorNode;
+        if (node && node.nodeType === 3) node = node.parentElement;
+        let block = node;
+        while (block && block !== ed && !/^(H1|H2|H3|P|DIV|LI)$/.test(block.tagName)) block = block.parentElement;
+        const tag = block && block !== ed ? block.tagName.toLowerCase() : 'p';
+        wmEl('wmStyle').value = ['h1', 'h2', 'h3'].includes(tag) ? tag : 'p';
+        if (node && node !== ed) {
+            const cs = getComputedStyle(node);
+            const fam = (cs.fontFamily || '').split(',')[0].replace(/["']/g, '').trim();
+            const opt = Array.from(wmEl('wmFont').options).find(o =>
+                o.value.replace(/["']/g, '').toLowerCase() === fam.toLowerCase());
+            if (opt) wmEl('wmFont').value = opt.value;
+            const pt = Math.round(parseFloat(cs.fontSize) * 72 / 96);
+            if (pt) { wmCurSize = pt; wmEl('wmSizeBox').textContent = pt; }
+        }
+    }
+
+    /* ---- wiring ---- */
+    (function wmWire() {
+        const ed = wmEl('wmEditor');
+        ed.addEventListener('input', wmEditorChanged);
+        ed.addEventListener('keydown', (e) => {
+            if (e.key === 'Tab') {
+                e.preventDefault();
+                document.execCommand(e.shiftKey ? 'outdent' : 'indent');
+                wmEditorChanged();
+            } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
+                e.preventDefault();
+                wmInsertLink();
+            }
+        });
+        /* Toolbar buttons must not steal the editor selection (selects need focus, skip those) */
+        wmEl('wmToolbar').addEventListener('mousedown', (e) => {
+            if (e.target.closest('.wm-tbtn')) e.preventDefault();
+        });
+        document.addEventListener('selectionchange', wmSyncToolbar);
+        document.addEventListener('keydown', (e) => {
+            if (!wmActive || e.key !== 'Escape') return;
+            const open = document.querySelector('.wm-palette.open');
+            if (open) { open.classList.remove('open'); return; }
+            exitWritingMode();
+        });
+        document.addEventListener('click', (e) => {
+            if (!e.target.closest('.wm-drop')) {
+                document.querySelectorAll('.wm-palette.open').forEach(p => p.classList.remove('open'));
+            }
+        });
+        window.addEventListener('beforeunload', () => { if (wmActive) wmFlush(true); });
+        document.addEventListener('visibilitychange', () => {
+            if (wmActive && document.visibilityState === 'hidden') wmFlush(true);
+        });
+    })();
+    </script>
 </body>
 </html>
