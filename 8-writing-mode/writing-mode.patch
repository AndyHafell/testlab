+def writing_mode_required(f):
+    """Writing Mode is a private admin surface (same invisible-404 contract as
+    the Labs): the session's identity_email must be in ADMIN_EMAILS. Reuses
+    _testing_lab_admin so impersonated/legacy sessions resolve identically."""
+    @wraps(f)
+    def decorated(*args, **kwargs):
+        if not _testing_lab_admin():
+            return jsonify({"error": "not found"}), 404
+        return f(*args, **kwargs)
+    return decorated
 
 
+@app.route("/api/videos/<int:vid>/writing-doc", methods=["GET"])
+@writing_mode_required
+@video_owner_required
+def get_writing_doc(vid):
+    conn = get_db()
+    row = conn.execute("SELECT writing_doc FROM videos WHERE id=?", (vid,)).fetchone()
+    conn.close()
+    if not row:
+        return jsonify({"error": "video not found"}), 404
+    return jsonify({"writing_doc": row["writing_doc"] or ""})
+
+
+@app.route("/api/videos/<int:vid>/writing-doc", methods=["POST"])
+@writing_mode_required
+@video_owner_required
+def save_writing_doc(vid):
+    body = request.get_json(force=True, silent=True) or {}
+    html = body.get("writing_doc", "")
+    conn = get_db()
+    conn.execute("UPDATE videos SET writing_doc=? WHERE id=?", (html, vid))
+    conn.commit()
+    conn.close()
+    return jsonify({"ok": True})
+
+
+_WRITING_IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
+
+
+@app.route("/api/videos/<int:vid>/writing-doc/image", methods=["POST"])
+@writing_mode_required
+@video_owner_required
+def upload_writing_image(vid):
+    """Image insert from the Writing Mode editor. Saves under
+    UPLOAD_DIR/writing/<vid>/ and returns the /static URL to embed."""
+    f = request.files.get("file")
+    if not f or not f.filename:
+        return jsonify({"error": "no file"}), 400
+    name = secure_filename(f.filename)
+    ext = os.path.splitext(name)[1].lower()
+    if ext not in _WRITING_IMAGE_EXTS:
+        return jsonify({"error": "unsupported file type"}), 400
+    out_dir = UPLOAD_DIR / "writing" / str(vid)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    fname = f"{int(time.time())}_{uuid.uuid4().hex[:6]}_{name}"
+    f.save(out_dir / fname)
+    return jsonify({"url": f"/static/uploads/writing/{vid}/{fname}"})
+
