+@app.route("/api/feedback/ab-tests", methods=["POST"])
+@login_required
+def create_ab_test():
+    gate = _feedback_admin_only()
+    if gate:
+        return gate
+    uid = current_user_id()
+    data = request.get_json(force=True, silent=True) or {}
+    title = (data.get("video_title") or "").strip()[:300]
+    if not title:
+        return jsonify({"error": "video_title required"}), 400
+    variants = _clean_ab_variants(data.get("variants"))
+    conn = get_db()
+    cur = conn.execute(
+        "INSERT INTO ab_tests (user_id, card_id, video_title, published, test_type, "
+        "status, variants, snapshot_at, updated_at) "
+        "VALUES (?, ?, ?, ?, ?, 'running', ?, ?, datetime('now'))",
+        (uid, data.get("card_id"), title,
+         str(data.get("published") or "")[:40],
+         str(data.get("test_type") or "title_and_thumbnail")[:60],
+         json.dumps(variants), str(data.get("snapshot_at") or "")[:40]))
+    conn.commit()
+    row = conn.execute("SELECT * FROM ab_tests WHERE id = ?", (cur.lastrowid,)).fetchone()
+    out = _ab_test_dict(conn, row)
+    conn.close()
+    return jsonify({"ok": True, "test": out}), 201
