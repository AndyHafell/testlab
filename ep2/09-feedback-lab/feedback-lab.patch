+@app.route("/api/feedback/checkins/<int:cid>/extract", methods=["POST"])
+@login_required
+def checkin_re_extract(cid):
+    gate = _feedback_admin_only()
+    if gate:
+        return gate
+    uid = current_user_id()
+    conn = get_db()
+    row = conn.execute("SELECT * FROM ab_checkins WHERE id = ? AND user_id = ?",
+                       (cid, uid)).fetchone()
+    if not row:
+        conn.close()
+        return jsonify({"error": "not found"}), 404
+    if not ub.can_afford(conn, uid, "checkin_extract"):
+        return budget_exhausted_response(conn, uid)
+    img_bytes, mime = _load_image_for_gemini(row["screenshot_url"])
+    if not img_bytes:
+        conn.close()
+        return jsonify({"error": "screenshot file missing"}), 410
+    ok, err = _run_checkin_extract(conn, uid, cid, img_bytes, mime)
+    conn.commit()
+    row = conn.execute("SELECT * FROM ab_checkins WHERE id = ?", (cid,)).fetchone()
+    conn.close()
+    if not ok:
+        return jsonify({"error": err, "checkin": dict(row)}), 502
+    return jsonify({"ok": True, "checkin": dict(row)})
