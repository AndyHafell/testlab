+@app.route("/api/feedback/ab-tests/<int:tid>", methods=["POST", "DELETE"])
+@login_required
+def update_ab_test(tid):
+    gate = _feedback_admin_only()
+    if gate:
+        return gate
+    uid = current_user_id()
+    conn = get_db()
+    row = _owned_ab_test(conn, tid, uid)
+    if not row:
+        conn.close()
+        return jsonify({"error": "not found"}), 404
+    if request.method == "DELETE":
+        conn.execute("DELETE FROM ab_checkins WHERE ab_test_id = ?", (tid,))
+        conn.execute("DELETE FROM ab_tests WHERE id = ?", (tid,))
+        conn.commit()
+        conn.close()
+        return jsonify({"ok": True})
+
+    data = request.get_json(force=True, silent=True) or {}
+    sets, args = [], []
+    if "video_title" in data and (data.get("video_title") or "").strip():
+        sets.append("video_title = ?"); args.append(str(data["video_title"]).strip()[:300])
+    if "published" in data:
+        sets.append("published = ?"); args.append(str(data.get("published") or "")[:40])
+    if "variants" in data:
+        variants = _clean_ab_variants(data.get("variants"))
+        sets.append("variants = ?"); args.append(json.dumps(variants))
+    else:
+        try:
+            variants = json.loads(row["variants"] or "[]")
+        except (TypeError, ValueError):
+            variants = []
+    if "winner_label" in data:
+        wl = str(data.get("winner_label") or "").strip()[:8]
+        if wl and wl not in [v.get("label") for v in variants]:
+            conn.close()
+            return jsonify({"error": "winner_label must match a variant label"}), 400
+        sets.append("winner_label = ?"); args.append(wl)
+        # Crowning implies the test is over (unless the caller says otherwise).
+        if wl and "status" not in data:
+            sets.append("status = 'complete'")
+    if "status" in data:
+        st = str(data.get("status") or "")
+        if st not in ("running", "complete"):
+            conn.close()
+            return jsonify({"error": "status must be running|complete"}), 400
+        sets.append("status = ?"); args.append(st)
+    if sets:
+        sets.append("updated_at = datetime('now')")
+        conn.execute(f"UPDATE ab_tests SET {', '.join(sets)} WHERE id = ?", (*args, tid))
+        conn.commit()
+    row = conn.execute("SELECT * FROM ab_tests WHERE id = ?", (tid,)).fetchone()
+    out = _ab_test_dict(conn, row)
+    conn.close()
+    return jsonify({"ok": True, "test": out})
 
 
+_CHECKIN_EXTRACT_PROMPT = """You are reading a YouTube Studio analytics screenshot the creator captured the morning after publishing (the first-24-hours / first-days view).
+
+Extract EXACTLY these fields. Use null for anything not visible. Numbers must be plain (strip commas; "2.2K" → 2200).
+- views: total views shown for this video so far
+- typical_low, typical_high: the channel's "typical performance" band on the views chart (the shaded range endpoints)
+- ctr_pct: impressions click-through rate, percent (e.g. 9.7)
+- avd: average view duration, like "3:08"
+- video_length: full video length if visible, like "12:15"
+- ranking: Studio's ranking-by-views line, exactly like "1 of 10"
+- likes, comments: counts if visible
+
+Return ONLY JSON with exactly those keys."""
+
+_CHECKIN_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "views": {"type": "integer", "nullable": True},
+        "typical_low": {"type": "integer", "nullable": True},
+        "typical_high": {"type": "integer", "nullable": True},
+        "ctr_pct": {"type": "number", "nullable": True},
+        "avd": {"type": "string", "nullable": True},
+        "video_length": {"type": "string", "nullable": True},
+        "ranking": {"type": "string", "nullable": True},
+        "likes": {"type": "integer", "nullable": True},
+        "comments": {"type": "integer", "nullable": True},
+    },
+}
+
+_CHECKIN_INT_COLS = ("views", "typical_low", "typical_high", "likes", "comments")
+_CHECKIN_STR_COLS = ("avd", "video_length", "ranking")
+
+
+def _checkin_fields_from_extract(r):
+    """Model JSON → sanitized column dict (ints/float/strings, junk → None)."""
+    out = {}
+    for k in _CHECKIN_INT_COLS:
+        try:
+            out[k] = None if r.get(k) is None else int(r[k])
+        except (TypeError, ValueError):
+            out[k] = None
+    try:
+        out["ctr_pct"] = None if r.get("ctr_pct") is None else round(float(r["ctr_pct"]), 2)
+    except (TypeError, ValueError):
+        out["ctr_pct"] = None
+    for k in _CHECKIN_STR_COLS:
+        out[k] = str(r.get(k) or "")[:40]
+    return out
+
+
+def _run_checkin_extract(conn, uid, cid, img_bytes, mime):
+    """Vision-extract metrics onto an existing ab_checkins row. Returns
+    (ok, err). Spends checkin_extract budget only on success."""
+    api_key = _user_gemini_key(uid)
+    if not api_key:
+        err = "No Gemini API key — add one in Settings."
+        conn.execute("UPDATE ab_checkins SET extract_error = ? WHERE id = ?", (err, cid))
+        return False, err
+    try:
+        r = _gemini_score_json(api_key, _CHECKIN_EXTRACT_PROMPT, img_bytes, mime,
+                               response_schema=_CHECKIN_SCHEMA, timeout=90)
+    except Exception as e:  # noqa: BLE001
+        err = f"{type(e).__name__}: {e}"[:300]
+        conn.execute("UPDATE ab_checkins SET extract_error = ? WHERE id = ?", (err, cid))
+        return False, err
+    f = _checkin_fields_from_extract(r or {})
+    conn.execute(
+        "UPDATE ab_checkins SET views=?, typical_low=?, typical_high=?, ctr_pct=?, "
+        "avd=?, video_length=?, ranking=?, likes=?, comments=?, extract_error='', "
+        "raw_extract=? WHERE id=?",
+        (f["views"], f["typical_low"], f["typical_high"], f["ctr_pct"], f["avd"],
+         f["video_length"], f["ranking"], f["likes"], f["comments"],
+         json.dumps(r or {}), cid))
+    ub.record_spend(conn, uid, "checkin_extract")
+    return True, None
+
