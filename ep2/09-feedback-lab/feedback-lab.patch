+    uid = current_user_id()
+    conn = get_db()
+    row = conn.execute("SELECT id FROM ab_checkins WHERE id = ? AND user_id = ?",
+                       (cid, uid)).fetchone()
+    if not row:
+        conn.close()
+        return jsonify({"error": "not found"}), 404
+    conn.execute("DELETE FROM ab_checkins WHERE id = ?", (cid,))
+    conn.commit()
+    conn.close()
+    return jsonify({"ok": True})
+
+
+def _feedback_learnings(conn, uid):
+    """Digest the user's Feedback Lab into prompt-ready text.
+
+    {ab_tests, checkins, text} — text is a capped plain-text summary of each
+    test's variants/shares/winner plus every check-in's measured metrics.
+    Empty lab → text "" so the scoring prompts are byte-identical to the
+    pre-Lab behavior."""
+    try:
+        tests = conn.execute(
+            "SELECT * FROM ab_tests WHERE user_id = ? "
+            "ORDER BY COALESCE(NULLIF(published,''), created_at) DESC, id DESC LIMIT 6",
+            (uid,)).fetchall()
+    except sqlite3.Error:
+        return {"ab_tests": 0, "checkins": 0, "text": ""}
+    lines, n_checkins = [], 0
+    for t in tests:
+        try:
+            variants = json.loads(t["variants"] or "[]")
+        except (TypeError, ValueError):
+            variants = []
+        lines.append(f"TEST — \"{t['video_title']}\" "
+                     f"({'complete' if t['status'] == 'complete' else 'still running'}):")
+        for v in variants:
+            tag = ""
+            if t["status"] == "complete" and v.get("label") == t["winner_label"]:
+                tag = " ← WINNER"
+            elif t["status"] != "complete" and v.get("leading"):
+                tag = " ← leading"
+            share = v.get("watch_time_share_pct")
+            share_s = f" — {share}% watch-time share" if share is not None else ""
+            lines.append(f"  [{v.get('label')}] \"{v.get('title')}\" "
+                         f"(thumb: {v.get('thumb_desc')}){share_s}{tag}")
+        cks = conn.execute(
+            "SELECT * FROM ab_checkins WHERE ab_test_id = ? AND views IS NOT NULL "
+            "ORDER BY day_index", (t["id"],)).fetchall()
+        for c in cks:
+            n_checkins += 1
+            band = (f" vs typical {c['typical_low']:,}–{c['typical_high']:,}"
+                    if c["typical_low"] is not None and c["typical_high"] is not None else "")
+            bits = [f"  Day {c['day_index']}: {c['views']:,} views{band}"]
+            if c["ctr_pct"] is not None:
+                bits.append(f"CTR {c['ctr_pct']}%")
+            if c["avd"]:
+                bits.append(f"AVD {c['avd']}")
+            if c["ranking"]:
+                bits.append(f"ranked {c['ranking']} on the channel")
+            lines.append(", ".join(bits))
+    return {"ab_tests": len(tests), "checkins": n_checkins,
+            "text": "\n".join(lines)[:1800]}
+
+
+def _learnings_block(fl):
+    """The shared prompt insert. Empty when the lab has no data."""
+    if not fl.get("text"):
+        return ""
+    return ("\nWHAT'S ACTUALLY BEEN WINNING ON THIS CHANNEL — real A/B test results "
+            "and measured post-publish Studio data from the creator's Feedback Lab. "
+            "These observed patterns outrank generic best practice; score/predict "
+            "against them (measured CTRs and first-day rankings are the strongest "
+            "signal):\n" + fl["text"] + "\n")
+
