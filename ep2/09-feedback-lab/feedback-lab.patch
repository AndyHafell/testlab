+@app.route("/api/feedback/lab")
+@login_required
+def feedback_lab():
+    gate = _feedback_admin_only()
+    if gate:
+        return gate
+    uid = current_user_id()
+    conn = get_db()
+    # data/ab_test_*.json are the admin's server-local Studio exports — lazily
+    # imported (insert-only, keyed by filename) so real test data shows up
+    # without a manual entry step. Non-admins never see them.
+    if _is_admin_email(session.get("identity_email") or session.get("email", "")):
+        _import_ab_test_files(conn, uid)
+    rows = conn.execute(
+        "SELECT * FROM ab_tests WHERE user_id = ? "
+        "ORDER BY COALESCE(NULLIF(published,''), created_at) DESC, id DESC",
+        (uid,)).fetchall()
+    out = [_ab_test_dict(conn, r) for r in rows]
+    conn.close()
+    return jsonify({"tests": out})
+
