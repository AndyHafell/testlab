+def _feedback_lab_enabled_for_session():
+    if FEEDBACK_LAB_OPEN:
+        return True
+    email = (session.get("impersonator_email") or session.get("identity_email")
+             or session.get("email") or "")
+    return _is_admin_email(email)
+
+
+def _feedback_admin_only():
+    """403 response for non-admins while the Lab is in private testing, else None."""
+    if _feedback_lab_enabled_for_session():
+        return None
+    return jsonify({"error": "Feedback Lab is in private testing."}), 403
+
+
+_AB_VARIANT_LABELS = "ABCD"
+
+
+def _clean_ab_variants(raw):
+    """Sanitize a client/file variants list → ≤4 dicts with known keys only."""
+    out = []
+    for i, v in enumerate(list(raw or [])[:4]):
+        if not isinstance(v, dict):
+            continue
+        share = v.get("watch_time_share_pct")
+        try:
+            share = None if share is None else round(float(share), 1)
+        except (TypeError, ValueError):
+            share = None
+        out.append({
+            "label": (str(v.get("label") or "").strip() or _AB_VARIANT_LABELS[i])[:8],
+            "title": str(v.get("title") or "").strip()[:200],
+            "thumb_desc": str(v.get("thumb_desc") or "").strip()[:300],
+            "watch_time_share_pct": share,
+            "leading": bool(v.get("leading")),
+        })
+    return out
+
+
+def _ab_test_dict(conn, row, with_checkins=True):
+    d = dict(row)
+    try:
+        d["variants"] = json.loads(row["variants"] or "[]")
+    except (TypeError, ValueError):
+        d["variants"] = []
+    if with_checkins:
+        rows = conn.execute(
+            "SELECT * FROM ab_checkins WHERE ab_test_id = ? ORDER BY day_index, id",
+            (row["id"],)).fetchall()
+        d["checkins"] = [dict(c) for c in rows]
+    return d
+
+
+def _owned_ab_test(conn, tid, uid):
+    return conn.execute(
+        "SELECT * FROM ab_tests WHERE id = ? AND user_id = ?", (tid, uid)).fetchone()
+
+
+def _import_ab_test_files(conn, uid):
+    """Insert-only sync of DATA_DIR/ab_test_*.json into the admin's ab_tests.
+
+    Keyed by filename: a file is imported once, then the app's rows are the
+    source of truth (re-import never clobbers crowns/edits). The JSON's
+    first_24h block seeds check-in day 1 when no day-1 check-in exists yet.
+    Malformed files are logged and skipped — the Lab page must never 500."""
+    try:
+        files = sorted(DATA_DIR.glob("ab_test_*.json"))
+    except OSError:
+        return
+    for p in files:
+        try:
+            data = json.loads(p.read_text(encoding="utf-8"))
+        except (OSError, ValueError) as e:
+            app.logger.warning("feedback import: skipping %s (%s)", p.name, e)
+            continue
+        row = conn.execute(
+            "SELECT id FROM ab_tests WHERE user_id = ? AND source_file = ?",
+            (uid, p.name)).fetchone()
+        if row:
+            test_id = row["id"]
+        else:
+            title = str(data.get("video") or data.get("video_title") or "").strip()
+            if not title:
+                app.logger.warning("feedback import: %s has no video title", p.name)
+                continue
+            cur = conn.execute(
+                "INSERT INTO ab_tests (user_id, source_file, video_title, published, "
+                "test_type, status, variants, snapshot_at, updated_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))",
+                (uid, p.name, title[:300], str(data.get("published") or "")[:40],
+                 str(data.get("test_type") or "title_and_thumbnail")[:60],
+                 "complete" if data.get("status") == "complete" else "running",
+                 json.dumps(_clean_ab_variants(data.get("variants"))),
+                 str(data.get("snapshot_at") or "")[:40]))
+            test_id = cur.lastrowid
+        f24 = data.get("first_24h") or {}
+        if f24 and not conn.execute(
+                "SELECT id FROM ab_checkins WHERE ab_test_id = ? AND day_index = 1",
+                (test_id,)).fetchone():
+            band = f24.get("typical_band") or [None, None]
+
+            def _i(v):
+                try:
+                    return None if v is None else int(v)
+                except (TypeError, ValueError):
+                    return None
+            try:
+                ctr = None if f24.get("ctr_pct") is None else float(f24["ctr_pct"])
+            except (TypeError, ValueError):
+                ctr = None
+            conn.execute(
+                "INSERT INTO ab_checkins (user_id, ab_test_id, day_index, views, "
+                "typical_low, typical_high, ctr_pct, avd, video_length, ranking, "
+                "likes, comments, raw_extract) VALUES (?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (uid, test_id, _i(f24.get("views")),
+                 _i(band[0] if len(band) > 0 else None),
+                 _i(band[1] if len(band) > 1 else None),
+                 ctr, str(f24.get("avd") or "")[:20],
+                 str(f24.get("video_length") or "")[:20],
+                 str(f24.get("ranking") or "")[:40],
+                 _i(f24.get("likes")), _i(f24.get("comments")),
+                 json.dumps(f24)))
+    conn.commit()
+
