+@app.route("/api/feedback/ab-tests/<int:tid>/checkin", methods=["POST"])
+@login_required
+def ab_test_checkin(tid):
+    gate = _feedback_admin_only()
+    if gate:
+        return gate
+    uid = current_user_id()
+    conn = get_db()
+    if not _owned_ab_test(conn, tid, uid):
+        conn.close()
+        return jsonify({"error": "not found"}), 404
+    if "file" not in request.files or not request.files["file"].filename:
+        conn.close()
+        return jsonify({"error": "No screenshot provided"}), 400
+    f = request.files["file"]
+    ext = Path(f.filename).suffix.lower()
+    if ext not in (".png", ".jpg", ".jpeg", ".webp"):
+        conn.close()
+        return jsonify({"error": "Invalid file type"}), 400
+    if not ub.can_afford(conn, uid, "checkin_extract"):
+        return budget_exhausted_response(conn, uid)
+
+    out_dir = UPLOAD_DIR / "checkins" / str(tid)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    filename = f"{uuid.uuid4().hex}{ext}"
+    img_bytes = f.read()
+    (out_dir / filename).write_bytes(img_bytes)
+    url = f"/static/uploads/checkins/{tid}/{filename}"
+    mime = "image/png" if ext == ".png" else ("image/webp" if ext == ".webp" else "image/jpeg")
+
+    day = conn.execute(
+        "SELECT COALESCE(MAX(day_index), 0) + 1 AS d FROM ab_checkins WHERE ab_test_id = ?",
+        (tid,)).fetchone()["d"]
+    cur = conn.execute(
+        "INSERT INTO ab_checkins (user_id, ab_test_id, day_index, screenshot_url) "
+        "VALUES (?, ?, ?, ?)", (uid, tid, day, url))
+    cid = cur.lastrowid
+    _run_checkin_extract(conn, uid, cid, img_bytes, mime)
+    conn.commit()
+    row = conn.execute("SELECT * FROM ab_checkins WHERE id = ?", (cid,)).fetchone()
+    conn.close()
+    return jsonify({"ok": True, "checkin": dict(row)}), 201
+
