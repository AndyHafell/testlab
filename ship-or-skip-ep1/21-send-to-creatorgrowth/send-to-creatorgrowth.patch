+def _decode_thumb_b64(s):
+    """Decode a thumbnail that may be raw base64 or a data: URL. Returns bytes
+    or None (empty/garbage slots stay blank rather than 500 the whole push)."""
+    import base64
+    if not isinstance(s, str) or not s.strip():
+        return None
+    raw = s.strip()
+    if raw.startswith("data:"):
+        comma = raw.find(",")
+        if comma != -1:
+            raw = raw[comma + 1:]
+    try:
+        return base64.b64decode(raw, validate=False)
+    except Exception:
+        return None
+
